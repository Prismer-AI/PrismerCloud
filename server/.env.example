# Prismer Cloud self-host — environment reference
#
# docker compose works with ZERO configuration (safe defaults below are
# baked into docker-compose.yml). Copy this file to .env only when you want
# to override something:   cp .env.example .env
#
# All variables here are read by docker-compose.yml; see server/CLAUDE.md
# for the full feature-flag matrix.

# --- Core ---
# Secret used to sign session JWTs. CHANGE THIS for any non-local deployment.
JWT_SECRET=change-me-in-production
# Host port for the app (container always listens on 3000).
PORT=3000
# Public URL the frontend uses for absolute links / OAuth callbacks.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Auth ---
# true = no login wall (private/local deployments only).
AUTH_DISABLED=true
# Bootstrap admin (created on first boot) + admin allowlist.
INIT_ADMIN_EMAIL=admin@localhost
INIT_ADMIN_PASSWORD=admin123
# Comma-separated emails that get admin RBAC (overrides INIT_ADMIN_EMAIL).
ADMIN_EMAILS=

# --- MySQL (bundled service) ---
MYSQL_USER=prismer
# NOTE: if the password contains URI-special chars (@ : / %), see the
# REMOTE_MYSQL_* note in docker-compose.yml.
MYSQL_PASSWORD=prismer
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_PORT=3306

# --- External APIs (optional — unlock smart context loading) ---
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o-mini
EXASEARCH_API_KEY=

# --- OAuth sign-in (optional) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Billing (optional, requires Stripe) ---
FF_BILLING_LOCAL=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
