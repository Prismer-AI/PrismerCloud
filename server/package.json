{
  "name": "prismer-cloud-next",
  "version": "2.0.8",
  "private": true,
  "scripts": {
    "dev": "npx tsx server.ts",
    "dev:next": "next dev",
    "dev:full": "./scripts/dev-up.sh",
    "dev:local": "bash scripts/sandbox/dev-loop.sh bootstrap-local",
    "dev:stack": "./scripts/dev-stack.sh up",
    "dev:stack:down": "./scripts/dev-stack.sh down",
    "dev:stack:status": "./scripts/dev-stack.sh status",
    "dev:stack:reset": "./scripts/dev-stack.sh reset",
    "dev:stack:logs": "./scripts/dev-stack.sh logs",
    "db:check": "./scripts/db-drift-check.sh",
    "db:migrate": "./scripts/db-migrate.sh up",
    "db:migrate:status": "./scripts/db-migrate.sh status",
    "db:migrate:baseline": "./scripts/db-migrate.sh baseline",
    "dev:e2e": "PRISMER_BASE_URL=http://127.0.0.1:3000 npx tsx scripts/e2e/local/run.ts",
    "mvp:zero-residual": "npx tsx scripts/mvp/zero-residual-rerun.ts",
    "mvp:m1-md-artifact": "npx tsx scripts/mvp/m1-local-daemon-hermes-markdown-artifact.ts",
    "release54:cloud": "npx tsx scripts/54release/run.ts",
    "release54:fixture": "npx tsx scripts/54release/mobile-fixture.ts",
    "test:playwright": "playwright test",
    "e2e:lifecycle": "playwright test e2e-playwright/specs/lifecycle-smoke.spec.ts",
    "e2e:lifecycle-full": "playwright test e2e-playwright/specs/lifecycle-full-trip.spec.ts",
    "e2e:lifecycle-roundtrip": "playwright test e2e-playwright/specs/lifecycle-roundtrip.spec.ts",
    "e2e:debug-bundle": "npx tsx scripts/e2e/debug-bundle.ts",
    "check:anti-patterns": "./scripts/check-anti-patterns.sh",
    "check:envelope-mirror": "npx tsx scripts/check-envelope-mirror.ts",
    "vendor:pdfjs": "node -e \"const fs=require('fs'),path=require('path');const src=path.join('node_modules','pdfjs-dist');const pub='public';const dst=path.join(pub,'pdfjs');fs.mkdirSync(dst,{recursive:true});for(const d of ['cmaps','standard_fonts']){const s=path.join(src,d),t=path.join(dst,d);fs.rmSync(t,{recursive:true,force:true});fs.cpSync(s,t,{recursive:true});}fs.copyFileSync(path.join(src,'build','pdf.worker.min.mjs'),path.join(pub,'pdf.worker.min.mjs'));console.log('[vendor:pdfjs] copied cmaps + standard_fonts + worker to public/');\"",
    "prebuild": "npm run vendor:pdfjs",
    "build": "next build",
    "start": "node custom-server.js",
    "start:next": "next start",
    "lint": "eslint",
    "lint:i18n": "tsx scripts/lint-i18n.ts",
    "im:start": "npx tsx src/im/start.ts",
    "im:dev": "npx tsx watch src/im/start.ts",
    "prisma:generate": "npx prisma generate",
    "prisma:generate:mysql": "npx prisma generate --schema=prisma/schema.mysql.prisma",
    "prisma:generate:all": "npx prisma generate && npx prisma generate --schema=prisma/schema.mysql.prisma",
    "prisma:push": "npx prisma db push",
    "prisma:studio": "npx prisma studio",
    "test": "vitest run",
    "test:unit": "vitest run src/lib/__tests__",
    "test:skills": "npx tsx src/im/skills/__tests__/frontmatter.test.ts && npx tsx src/im/skills/__tests__/manifest.test.ts && npx tsx src/im/services/__tests__/built-in-skill.service.test.ts",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:all": "npx tsx scripts/test-all-apis.ts",
    "test:all:local": "TEST_ENV=local npx tsx scripts/test-all-apis.ts",
    "test:all:test": "TEST_ENV=test npx tsx scripts/test-all-apis.ts",
    "test:all:prod": "TEST_ENV=prod npx tsx scripts/test-all-apis.ts",
    "docs:split": "npx tsx scripts/docs/split-spec.ts",
    "docs:merge": "npx tsx scripts/docs/merge-fragments.ts",
    "docs:check": "npx tsx scripts/docs/merge-fragments.ts --check",
    "docs:extract": "npx tsx scripts/docs/extract-samples.ts",
    "docs:coverage": "npx tsx scripts/docs/validate-coverage.ts",
    "docs:build": "npx tsx scripts/docs/extract-samples.ts && npx tsx scripts/docs/merge-fragments.ts",
    "docs:api-gen": "npx tsx scripts/docs/generate-api-docs.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "check": "eslint && tsc --noEmit",
    "circular": "madge --circular --extensions ts,tsx src/",
    "prepare": "husky"
  },
