// ==============================================================================
// Prismer Cloud - IM Server 数据库 Schema
// ==============================================================================
//
// 本地开发使用 SQLite，生产使用 MySQL
// IM Server 使用独立的表，前缀 im_
//
// 运行命令:
//   npx prisma generate        - 生成 Prisma Client
//   npx prisma db push         - 创建/更新数据库表
//   npx prisma studio          - 打开可视化管理界面
//
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// IM 用户
// ==============================================================================

model IMUser {
  id           String   @id @default(cuid())
  username     String // agents: per-workspace unique (enforced in register.ts); humans: globally unique
  displayName  String
  passwordHash String?
  role         String   @default("human") // human | agent | admin
  agentType    String? // assistant | specialist | orchestrator | tool | bot
  avatarUrl    String?
  metadata     String? // JSON
  userId       String? // 关联主应用用户（可多个 agent 共享同一 userId）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Security (v1.7.2)
  trustTier       Int       @default(0) // 0-4 trust level
  violationCount  Int       @default(0)
  suspendedUntil  DateTime?
  lastViolationAt DateTime?
  // Moderation (v1.7.3)
  reportBanUntil  DateTime?
  quarantineCount Int       @default(0)
  publishCount    Int       @default(0)
  banned          Boolean   @default(false)
  bannedAt        DateTime?
  banReason       String?
  // AIP Layer 1: DID identity
  primaryDid      String?   @unique // did:key:z6Mk...
  delegatedBy     String? // Delegator's DID

  // Contact system (v1.8.0 P9)
  institution String?
  description String?
  lastSeenAt  DateTime?

  // Native Auth (v1.9.4) — replaces Go-backend `prismer_info.users` for new accounts
  email         String? @unique // primary login email (NULL OK for agent rows)
  phone         String? @unique // E.164
  googleId      String? @unique
  githubId      String? @unique
  appleId       String? @unique
  twitterId     String? @unique
  emailVerified Boolean @default(false)
  numericId     Int?    @unique // BIGINT allocator (Int in SQLite, BigInt UNSIGNED AUTO_INCREMENT in MySQL)

  agentCard                IMAgentCard?
  identityKey              IMIdentityKey?
  participations           IMParticipant[]
  sentMessages             IMMessage[]
  createdConversations     IMConversation[]
  readCursors              IMReadCursor[]
  bindings                 IMBinding[]
  channelAccountsOwned     IMChannelAccount[]   @relation("ChannelAccountOwner")
  externalIdentitiesLinked IMExternalIdentity[] @relation("ExternalIdentityLink")
  credit                   IMCredit?
  fileUploads              IMFileUpload[]

  // Contact system relations (v1.8.0 P9)
  friendRequestsSent     IMFriendRequest[]   @relation("FriendRequestsSent")
  friendRequestsReceived IMFriendRequest[]   @relation("FriendRequestsReceived")
  contactsOwned          IMContactRelation[] @relation("ContactsOwned")
  contactsOf             IMContactRelation[] @relation("ContactsOf")
  blocksOwned            IMBlock[]           @relation("BlocksOwned")
  blockedBy              IMBlock[]           @relation("BlockedBy")

  @@index([role])
  @@index([userId])
  @@index([primaryDid])
  @@index([email])
  @@index([numericId])
  @@map("im_users")
}

// ==============================================================================
// Agent 名片 (能力声明)
// ==============================================================================

model IMAgentCard {
  id              String    @id @default(cuid())
  imUserId        String    @unique
  name            String
  description     String    @default("")
  agentType       String    @default("assistant")
  capabilities    String    @default("[]") // JSON: AgentCapability[]
  protocolVersion String    @default("1.0")
  endpoint        String? // HTTP endpoint for direct invocation
  metadata        String    @default("{}") // JSON
  lastHeartbeat   DateTime?
  status          String    @default("offline") // online | busy | idle | offline
  load            Float     @default(0) // 0-1 utilization
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // AIP Layer 2: DID Document
  did            String? // Agent's did:key
  didDocumentUrl String? // did:web resolution URL

  imUser IMUser @relation(fields: [imUserId], references: [id], onDelete: Cascade)

  workspaceId String // 1.9.2 Phase 2: workspace-owned memory

  @@index([status])
  @@index([workspaceId])
  @@map("im_agent_cards")
}

// ==============================================================================
// AIP Layer 3-4: Agent Credentials, DID Mappings, Revocation
// ==============================================================================

model IMAgentCredential {
  id             String    @id @default(cuid())
  holderDid      String
  credentialType String // AgentDelegation | TaskCompletion | Reputation | Capability
  issuerDid      String
  credential     String // Full VC JSON-LD (with proof)
  validFrom      DateTime
  validUntil     DateTime?
  revoked        Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([holderDid])
  @@index([issuerDid])
  @@index([credentialType])
  @@map("im_agent_credentials")
}

model IMDIDMapping {
  id        String   @id @default(cuid())
  did       String   @unique
  imUserId  String
  didMethod String // "key" | "web"
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([imUserId])
  @@map("im_did_mappings")
}

model IMRevocationEntry {
  id              String   @id @default(cuid())
  issuerDid       String
  targetDid       String
  credentialId    String?
  reason          String
  statusListIndex Int
  createdAt       DateTime @default(now())

  @@unique([issuerDid, targetDid, credentialId])
  @@index([targetDid])
  @@map("im_revocation_entries")
}

// ==============================================================================
// 对话
// ==============================================================================

model IMConversation {
  id            String    @id @default(cuid())
  type          String    @default("direct") // direct | group | channel
  title         String?
  description   String?
  status        String    @default("active") // active | archived | deleted
  metadata      String    @default("{}") // JSON
  createdById   String
  workspaceId   String? // 关联 Workspace (1.9.x: 1 ws → N conversations，去掉 1.8.2 误加的 @unique)
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdBy        IMUser              @relation(fields: [createdById], references: [id])
  participants     IMParticipant[]
  messages         IMMessage[]
  readCursors      IMReadCursor[]
  externalRoutings IMExternalRouting[] @relation("ExternalRoutings")

  @@index([status])
  @@index([createdById])
  @@index([lastMessageAt])
  @@index([workspaceId])
  @@map("im_conversations")
}

// ==============================================================================
// 参与者
// ==============================================================================

model IMParticipant {
  id             String    @id @default(cuid())
  conversationId String
  imUserId       String
  role           String    @default("member") // owner | admin | member | observer
  joinedAt       DateTime  @default(now())
  leftAt         DateTime?
  pinned         Boolean   @default(false)
  muted          Boolean   @default(false)
  pinnedAt       DateTime?

  conversation IMConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  imUser       IMUser         @relation(fields: [imUserId], references: [id], onDelete: Cascade)

  @@unique([conversationId, imUserId])
  @@index([imUserId])
  @@map("im_participants")
}

// ==============================================================================
// 消息
// ==============================================================================

model IMMessage {
  id                String   @id @default(cuid())
  conversationId    String
  senderId          String
  type              String   @default("text") // text | markdown | code | image | file | tool_call | tool_result | system_event | thinking
  content           String   @default("")
  metadata          String   @default("{}") // JSON: MessageMetadata
  attachments       Json? // JSON: AssetAttachment[]
  // v2.0 §4.6 / 14b §4.1 (migration 406): canonical multimodal payload as
  // ContentBlock[] (text | image | audio | video | file | tool_use |
  // tool_result | reasoning). Dual-write with `content` + `attachments`.
  contentBlocksJson Json?
  // v2.0 §4.1 (migration 402): first-class idempotencyKey (UNIQUE with conversationId).
  idempotencyKey    String?
  parentId          String? // For threading
  quotedMessageId   String? // Quote reply reference (v1.8.2, distinct from parentId threading)
  status            String   @default("sent") // sending | sent | delivered | read | failed
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // E2E Encryption Layer 2: Signing & Integrity (v1.7.2)
  secVersion  Int? // Security protocol version (null = legacy unsigned)
  senderKeyId String? // Identity key ID used for signing
  sequence    Int? // Monotonic per (senderId, conversationId)
  contentHash String? // SHA-256(body) hex
  prevHash    String? // Previous message's contentHash
  signature   String? // Ed25519 signature (Base64)

  // AIP Layer 2: DID-based signing
  senderDid       String? // did:key:z6Mk... (preferred over senderKeyId)
  delegationProof String? // JSON: simplified delegation chain proof

  // E2E Layer 5: encryption first-class field (S5 fix)
  encrypted Boolean @default(false)

  // release201/26 §4 (Conversational Memory Phase 1) — cl100k (tiktoken) token
  // count, backfilled by a background worker. EXPLICITLY excluded from the
  // signing canonical string (secVersion|senderDid|type|timestamp|contentHash
  // and version|senderId|senderKeyId|conversationId|sequence|type|timestamp|
  // contentHash|prevHash — see src/im/crypto/index.ts:175-232). contentHash
  // only hashes `content` (computeContentHash), so backfilling this column
  // never invalidates an existing signature.
  tokenCountCl100k Int?

  conversation IMConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       IMUser              @relation(fields: [senderId], references: [id])
  reactions    IMMessageReaction[]

  @@unique([conversationId, idempotencyKey])
  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@index([parentId])
  @@index([quotedMessageId])
  @@index([senderDid])
  @@index([conversationId, senderId, sequence])
  @@map("im_messages")
}

// ==============================================================================
// 消息反应 (Reactions, v1.8.2)
// ==============================================================================
//
// 独立表存储反应，避免在 message.metadata JSON 上做读-改-写造成的丢失更新竞态。
// 复合唯一键保证 idempotent add；删除使用 deleteMany 同样 idempotent。

model IMMessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message IMMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
  @@map("im_message_reactions")
}

// ==============================================================================
// 已读位置追踪
// ==============================================================================

model IMReadCursor {
  id             String   @id @default(cuid())
  conversationId String
  imUserId       String
  lastReadAt     DateTime @default(now())
  lastReadMsgId  String?

  conversation IMConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  imUser       IMUser         @relation(fields: [imUserId], references: [id], onDelete: Cascade)

  @@unique([conversationId, imUserId])
  @@index([imUserId])
  @@map("im_read_cursors")
}

// ==============================================================================
// Webhook 配置
// ==============================================================================

model IMWebhook {
  id            String    @id @default(cuid())
  url           String
  events        String    @default("[]") // JSON: string[]
  secret        String?
  active        Boolean   @default(true)
  createdById   String
  failureCount  Int       @default(0)
  lastTriggered DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active])
  @@map("im_webhooks")
}

// ==============================================================================
// v0.3.0 — 社交平台绑定
// ==============================================================================

model IMBinding {
  id       String @id @default(cuid())
  imUserId String
  platform String // telegram | discord | slack
  status   String @default("pending") // pending | active | failed | revoked

  // 平台侧信息
  externalId   String? // 平台用户ID (Telegram chat_id, Discord user_id)
  externalName String? // 平台用户名

  // 认证信息
  botToken   String? // Bot Token
  webhookUrl String? // Webhook URL
  channelId  String? // channel/chat ID

  // 验证
  verificationCode String?
  verifiedAt       DateTime?

  // 能力
  capabilities String @default("[]") // JSON: ["receive_message","send_message"]

  // 配置
  config String @default("{}") // JSON

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  imUser         IMUser            @relation(fields: [imUserId], references: [id], onDelete: Cascade)
  bridgeMessages IMBridgeMessage[]

  @@unique([imUserId, platform])
  @@index([platform, status])
  @@map("im_bindings")
}

// ==============================================================================
// v0.3.0 — 消息桥接记录
// ==============================================================================

model IMBridgeMessage {
  id                 String  @id @default(cuid())
  bindingId          String
  channelAccountId   String?
  externalIdentityId String?
  direction          String // inbound | outbound

  // IM 侧
  imMessageId      String?
  imConversationId String?

  // 外部侧
  externalMessageId String?
  externalGroupId   String?

  // 状态
  status       String  @default("sent") // sent | delivered | failed
  errorMessage String?

  createdAt DateTime @default(now())

  binding          IMBinding           @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  channelAccount   IMChannelAccount?   @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  externalIdentity IMExternalIdentity? @relation(fields: [externalIdentityId], references: [id], onDelete: SetNull)

  @@index([bindingId])
  @@index([channelAccountId, direction, createdAt])
  @@index([externalMessageId])
  @@index([imMessageId])
  @@map("im_bridge_messages")
}

// ==============================================================================
// v2.0.0 — External channel accounts and routing
// ==============================================================================

model IMChannelAccount {
  id                String    @id @default(cuid())
  ownerImUserId     String
  workspaceId       String?
  platform          String // wechat | wecom | whatsapp | telegram | discord
  label             String
  status            String    @default("pending") // pending | online | offline | failed | revoked
  credentials       String    @default("{}") // JSON: platform-specific encrypted credentials
  accountIdentifier String?
  lastConnectedAt   DateTime?
  lastErrorMessage  String?
  capabilities      String    @default("{}") // JSON: { groupNative, outboundOnly, ... }
  config            String    @default("{}") // JSON: platform runtime config
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  owner              IMUser               @relation("ChannelAccountOwner", fields: [ownerImUserId], references: [id], onDelete: Cascade)
  workspace          IMWorkspace?         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  externalIdentities IMExternalIdentity[]
  bridgeMessages     IMBridgeMessage[]

  @@index([ownerImUserId, platform])
  @@index([workspaceId, platform])
  @@index([platform, status])
  @@map("im_channel_accounts")
}

model IMExternalIdentity {
  id               String    @id @default(cuid())
  channelAccountId String
  externalUserId   String
  externalName     String?
  avatarUrl        String?
  linkedImUserId   String?
  linkedAt         DateTime?
  linkSource       String?
  lastContextToken String?
  tokenExpiresAt   DateTime?
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  metadata         String    @default("{}") // JSON: platform-specific identity metadata

  channelAccount IMChannelAccount    @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  linkedImUser   IMUser?             @relation("ExternalIdentityLink", fields: [linkedImUserId], references: [id], onDelete: SetNull)
  routings       IMExternalRouting[]
  bridgeMessages IMBridgeMessage[]

  @@unique([channelAccountId, externalUserId])
  @@index([linkedImUserId])
  @@index([tokenExpiresAt])
  @@map("im_external_identities")
}

model IMExternalRouting {
  id                 String    @id @default(cuid())
  externalIdentityId String
  conversationId     String
  isDefault          Boolean   @default(false)
  lastInboundAt      DateTime?
  lastOutboundAt     DateTime?
  createdAt          DateTime  @default(now())

  externalIdentity IMExternalIdentity @relation(fields: [externalIdentityId], references: [id], onDelete: Cascade)
  conversation     IMConversation     @relation("ExternalRoutings", fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([externalIdentityId, conversationId])
  @@index([externalIdentityId, isDefault])
  @@index([conversationId])
  @@map("im_external_routings")
}

// ==============================================================================
// v0.3.0 — 本地 Credits (开发环境, 生产桥接到 pc_user_credits)
// ==============================================================================

model IMCredit {
  id          String @id @default(cuid())
  imUserId    String @unique
  balance     Float  @default(100000) // 注册即送 100000 credits ≈ 1 亿条消息 (0.001/条)
  totalEarned Float  @default(0)
  totalSpent  Float  @default(0)

  updatedAt DateTime @updatedAt

  imUser       IMUser                @relation(fields: [imUserId], references: [id])
  transactions IMCreditTransaction[]

  @@map("im_credits")
}

// ==============================================================================
// v0.3.0 — 本地交易记录 (开发环境)
// ==============================================================================

model IMCreditTransaction {
  id            String  @id @default(cuid())
  creditId      String
  type          String // usage | topup | refund | bonus
  amount        Float // 正=收入, 负=支出
  balanceAfter  Float
  description   String?
  referenceType String? // message | workspace | binding
  referenceId   String?

  createdAt DateTime @default(now())

  credit IMCredit @relation(fields: [creditId], references: [id])

  @@index([creditId])
  @@map("im_credit_transactions")
}

// ==============================================================================
// v1.6.0 — Context Cache (Prisma-first, replaces backend context_data)
// ==============================================================================

model ContextCache {
  id          String    @id @default(cuid())
  userId      String // Cloud user ID (from apiGuard)
  rawLink     String // URL or input identifier
  rawLinkHash String    @unique // SHA-256(rawLink), computed in service
  contentUri  String? // prismer://{visibility}/{short_id}/{content_id}
  hqccContent String    @default("") // Compressed content (up to 100MB)
  intrContent String? // Raw/intermediate content (up to 100MB)
  visibility  String    @default("private") // public | private | unlisted
  meta        String    @default("{}") // JSON metadata
  tags        String    @default("[]") // JSON: string[] — search tags
  sizeBytes   Int       @default(0) // Total content bytes (for 100MB gate)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([userId, visibility])
  @@index([expiresAt])
  @@map("im_context_cache")
}

// ==============================================================================
// v1.6.0 — 文件上传记录 (IM File Transfer)
// ==============================================================================

model IMFileUpload {
  id        String    @id @default(cuid())
  imUserId  String
  uploadId  String    @unique // S3 upload ID or local ID
  fileName  String
  fileSize  Int // bytes
  mimeType  String
  sha256    String? // integrity check
  s3Key     String? // S3 object key
  cdnUrl    String? // CDN delivery URL
  status    String    @default("pending") // pending | uploaded | confirmed | failed
  expiresAt DateTime? // presigned URL expiry
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  imUser IMUser @relation(fields: [imUserId], references: [id], onDelete: Cascade)

  @@index([imUserId])
  @@index([status])
  @@map("im_file_uploads")
}

// ==============================================================================
// v1.7.0 — Sync Events (offline-first SDK)
// ==============================================================================

model IMSyncEvent {
  id             Int       @id @default(autoincrement())
  type           String // message.new | message.edit | message.delete | conversation.create | conversation.update
  data           String    @default("{}") // JSON
  conversationId String?
  // v2.0 §4.1 (migration 401): per-conversation monotonic seq.
  boundarySeq    BigInt?
  imUserId       String
  createdAt      DateTime  @default(now())
  // v2.0 §4.1: publisher worker stamp — NULL until publish succeeds.
  publishedAt    DateTime?
  publishRetries Int       @default(0)

  @@index([imUserId])
  @@index([conversationId])
  @@index([conversationId, boundarySeq])
  @@index([publishedAt, id])
  @@index([createdAt])
  @@map("im_sync_events")
}

// v2.0 §4.1 (migration 401): per-conversation monotonic seq counter.
model IMConversationSeq {
  conversationId String @id
  seq            BigInt @default(0)

  @@map("im_conversation_seq")
}

// v2.0 §4.4.7 (migration 417): streaming partial render chunks.
// One row per `stream.service` flush tick (~200ms granularity). The chunk
// buffer for F5 hydration — final message persists separately via the
// `message.created` outbox event (Wave 2-B1). Reaper sweeps rows >24h
// (scheduler.sweepMessagePartials).
model IMMessagePartial {
  id        String   @id
  messageId String
  chunkText String
  chunkSeq  Int
  createdAt DateTime @default(now())

  @@index([messageId, chunkSeq])
  @@index([createdAt])
  @@map("im_message_partials")
}

// ==============================================================================
// v1.7.2 — Task Orchestration (Cloud Task Store + Scheduler)
// ==============================================================================

model IMTask {
  id String @id @default(cuid())

  // Task content
  title        String
  description  String?
  capability   String? // Required agent capability
  // Cloud 3 / S3: task execution surface — agent | sandbox | shell
  runtimeRoute String? @default("agent")
  // Cloud 3 / S3: sandbox execution backref (set by dispatchToSandbox)
  containerId  String?
  input        String  @default("{}") // JSON: task input
  contextUri   String? // prismer:// reference

  // Participants
  creatorId      String // Who created (human or agent)
  assigneeId     String? // Who is executing
  conversationId String? // Associated conversation (v1.8.2)

  // State machine (v2.0 / release 200 §5.1):
  //   pending → assigned → running → review → completed | failed | cancelled
  //                            ↘ blocked ↗
  // 'blocked' is v2.0 addition — agent self-reports stuck, needs intervention.
  // App-layer enum (VARCHAR, NOT a MySQL ENUM) — see migration 341.
  status        String  @default("pending")
  // v2.0 §4.2 (migration 403): execution phase decoupled from status.
  // thinking | tool_use | reasoning | responding | waiting_user | waiting_dep | stuck.
  currentPhase  String?
  progress      Float? // 0.0-1.0 numeric progress (v1.8.2)
  statusMessage String? // Human-readable status update (v1.8.2)
  position      Float? // Kanban order — B-tree midpoint method (v2.0 §8 migration 342)

  // Scheduling
  scheduleType     String? // NULL (immediate) | once | interval | cron
  scheduleAt       DateTime? // once: target time
  scheduleCron     String? // cron: expression (e.g. "0 9 * * *")
  intervalMs       Int? // interval: milliseconds between runs
  nextRunAt        DateTime? // Next dispatch time (scheduler uses this)
  lastRunAt        DateTime?
  // v2.0 §4.2 (migration 403): daemon-pushed phase heartbeat (~15s).
  lastHeartbeatAt  DateTime?
  heartbeatVersion BigInt    @default(0)
  runCount         Int       @default(0)
  maxRuns          Int? // NULL = unlimited

  // Result
  result    String? // JSON: execution result
  resultUri String? // prismer:// result reference
  error     String?

  // Economy
  budget Float? // Max credits budget
  cost   Float  @default(0) // Actual cost

  // Timeout / Retry
  timeoutMs    Int       @default(300000) // 5 min default
  deadline     DateTime?
  completedAt  DateTime? // When task reached completed state (v1.8.2)
  maxRetries   Int       @default(0) // OpenClaw retry.max alignment
  retryDelayMs Int       @default(60000) // Exponential backoff base (ms)
  retryCount   Int       @default(0) // Current retry count

  // Metadata
  metadata  String   @default("{}") // JSON: session_target, delivery, wake_mode, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs IMTaskLog[]
  runs IMTaskRun[]

  workspaceId String? // 1.9.2 Phase 1 (m2 NULLable, m3 NOT NULL + drop scope)

  // release201/09 Phase 2 (migration 433): project scope. NULL = workspace-level
  // (unscoped). Composite index supports board/task-list filter by (project + status).
  projectId String?

  // release201/10 (migration 438): acceptance criteria + rolled-up status.
  acceptanceCriteriaJson String?
  acceptanceStatus       String  @default("none")

  @@index([status])
  @@index([assigneeId, status])
  @@index([capability, status])
  @@index([scheduleType, nextRunAt, status])
  @@index([creatorId])
  @@index([creatorId, status])
  @@index([conversationId])
  @@index([completedAt])
  @@index([workspaceId])
  @@index([runtimeRoute, status])
  @@index([containerId])
  @@index([status, lastHeartbeatAt])
  @@index([projectId, status])
  @@index([acceptanceStatus])
  @@map("im_tasks")
}

// release201/10 (migration 439): IMTaskCriteriaTemplate
model IMTaskCriteriaTemplate {
  id           String   @id @default(cuid())
  workspaceId  String?
  capability   String
  name         String
  description  String?
  criteriaJson String
