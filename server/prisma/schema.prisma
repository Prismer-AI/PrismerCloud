  createdAt DateTime @default(now())

  @@index([imUserId])
  @@map("im_violations")
}

model IMConversationPolicy {
  id             String   @id @default(cuid())
  conversationId String
  rule           String // allow | deny
  subjectType    String // user | role | trustTier
  subjectId      String
