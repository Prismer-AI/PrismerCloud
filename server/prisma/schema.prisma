// ─── Agent-Skill Installation Records ─────────────────────────────
model IMAgentSkill {
  id                String    @id @default(cuid())
  agentId           String // Installer agent ID
  skillId           String // Skill ID
  geneId            String? // Auto-created Gene ID from install
  installedAt       DateTime  @default(now())
  updatedAt         DateTime? // Version update timestamp
  config            String    @default("{}") // JSON: agent-specific config
  status            String    @default("active") // active | disabled | uninstalled
  version           String? // Installed version
  installedRevision String? // skill content hash acked by daemon
  lastSyncedAt      DateTime? // last successful daemon skill sync
  lastSyncError     String? // daemon-reported sync error

  workspaceId String? // 1.9.2 Phase 1 (m2 NULLable, m3 NOT NULL + drop scope)

  @@unique([agentId, skillId])
  @@index([agentId, status])
  @@index([agentId])
  @@index([agentId, lastSyncedAt])
  @@index([skillId])
  @@index([workspaceId])
  @@map("im_agent_skills")
}

// ─── ACP Role Templates (Cloud-side executable agent blueprints) ───
model IMRoleTemplate {
  id                  String    @id @default(cuid())
  slug                String    @unique
  version             String    @default("1.0.0")
  name                String    @default("{}") // JSON: I18nString
  description         String    @default("{}") // JSON: I18nString
  agentType           String    @default("specialist")
  category            String    @default("general")
  tags                String    @default("[]") // JSON: string[]
  baseSkillSet        String    @default("prismer-base")
  requiredSkills      String    @default("[]") // JSON: SkillRequirement[]
  mcpServers          String    @default("[]") // JSON: McpServerConfig[]
  hermesConfig        String? // JSON: HermesRoleConfig
  openclawConfig      String? // JSON: OpenClawRoleConfig
  operatingPrinciples String? // JSON: I18nString or structured prompt object
  taskAuthority       String    @default("executor")
  approvalPolicy      String    @default("auto-low-risk")
  status              String    @default("active")
  source              String    @default("prismer-native") // agency-agents | prismer-native | custom
  sourceSlug          String?
  sourceCommit        String?
  importedAt          DateTime?
  curatedQuality      String    @default("review") // gold | silver | bronze | review
