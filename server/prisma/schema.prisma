model IMMemoryFile {
  id        String   @id @default(cuid())
  ownerId   String // user or agent ID
  ownerType String   @default("agent") // 'user' | 'agent'
  path      String   @default("MEMORY.md") // file path: 'MEMORY.md', 'patterns.md', etc.
  content   String   @default("") // Markdown content
  version   Int      @default(1) // Optimistic lock
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memoryType         String? // 'feedback' | 'project' | 'reference' | 'insight'
  description        String? // Short description for search indexing
  lastConsolidatedAt DateTime? // Last Dream consolidation timestamp
  stale              Boolean   @default(false) // Stale flag for aging

  workspaceId String // 1.9.2 Phase 2: workspace-owned memory

  // v2.0 Wave 4-E6 (doc 13 §6.1 + 14 §4.7) — agent scope bucket + sentinel
  //   scope='workspace-shared' → ownerType='workspace', ownerId='__shared__',
  //                              agentImUserId NULL; all agents RW
  //   scope='agent-private'    → agentImUserId required; only that agent RW
  // Migration 412 (doc 13) installs scope column + sentinel UNIQUE key;
  // migration 418 (Wave 4-E6) adds agentImUserId + (agentImUserId,scope) index.
  agentImUserId String?
  scope         String  @default("workspace-shared") // workspace-shared | agent-private

  visibility  String  @default("workspace")
  aclJson     String?
  encrypted   Boolean @default(false)
  contentHash String
  etag        String?
  sourceKind  String?
  sourceRef   String?

