// ==============================================================================
// v1.9.x Workspace Data Model (Track A m1, migration 100)
// ==============================================================================
// Workspace 是 first-class 用户数据上下文，1.9.x 阶段 1:1 with IMUser。
// 替代 1.8.0 留下的 scope 字符串约定 (12 张表的 `scope: 'global' | 'ws_xxx'`).
// 详见 docs/refactor/02-workspace-data-model.md
//
// 注意:
//   - IMAgentProfile 是 adapter-local 配置 (cwd/model/MCP/env/prompt)。
//     OpenClaw/Hermes 文档里叫的 "workspace" 对应 IMAgentProfile，不是 IMWorkspace。
//   - IMAsset 是 content-addressed immutable blob (sha256 标识)。
//   - IMWorkspaceFile 是 mutable path → asset binding (workspace 文件树)。
//
// 关系采用 prisma logical FK：仅加 String 字段 + index/unique，不加 IMUser 的反向
// relation 字段（避免污染 IMUser 模型）。SQL 层在 100_v191_workspaces.sql 加 FK
// constraint。

model IMWorkspace {
  id            String    @id @default(cuid())
  ownerImUserId String
  name          String // 'Personal' | 'Acme Inc'
  slug          String // URL-friendly
  isDefault     Boolean   @default(false)
  metadata      String    @default("{}") // JSON: avatar / color / description
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Orchestrator deputy (v2.0 release 200 §4 — migration 343).
  // At most one active orchestrator per workspace (service-layer enforced).
  // Authorized by owner; revocable. See 15-task-state-machine-and-kanban.md.
  orchestratorAgentId              String?
  orchestratorAuthorizedAt         DateTime?
  orchestratorAuthorizedByImUserId String?
  orchestratorRevokedAt            DateTime?

  members         IMWorkspaceMember[]
  invites         IMWorkspaceInvite[]
  agentProfiles   IMAgentProfile[]
  assets          IMAsset[]
  files           IMWorkspaceFile[]
  channelAccounts IMChannelAccount[]

  @@unique([ownerImUserId, slug, deletedAt])
  @@index([ownerImUserId, isDefault])
  @@map("im_workspaces")
}

model IMWorkspaceMember {
  id             String   @id @default(cuid())
  workspaceId    String
  memberImUserId String
  role           String // 'owner' | 'admin' | 'member'
  joinedAt       DateTime @default(now())

  workspace IMWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, memberImUserId])
  @@index([memberImUserId])
  @@map("im_workspace_members")
}

// release201/16 Phase 9 — workspace invite token system. See mysql schema for
// the full rationale; SQLite mirror lives here for dev parity.
model IMWorkspaceInvite {
  id               String    @id @default(cuid())
  workspaceId      String
  inviterUserId    String
  token            String    @unique
  inviteeEmail     String?
  inviteeImUserId  String?
  role             String    @default("member") // 'admin' | 'member'
  status           String    @default("pending") // 'pending' | 'accepted' | 'rejected' | 'revoked' | 'expired'
  expiresAt        DateTime
  acceptedByUserId String?
  acceptedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace IMWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([inviteeEmail])
  @@index([inviteeImUserId])
  @@index([expiresAt])
  @@map("im_workspace_invites")
}

// Project scope container (release201/09 Phase 1, v2.0.7) — see mysql schema for full rationale.
model IMProject {
  id          String    @id @default(cuid())
  workspaceId String
  slug        String
  name        String
  description String?
  status      String    @default("active") // 'active' | 'archived'
  ownerUserId String
  metadata    String    @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  members IMAgentProjectMembership[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([ownerUserId])
  @@index([status])
  @@map("im_projects")
}

model IMAgentProjectMembership {
  id            String   @id @default(cuid())
  projectId     String
  principalKind String // 'user' | 'agent'
  principalId   String
  role          String   @default("contributor") // 'owner' | 'contributor' | 'observer'
  joinedAt      DateTime @default(now())

  project IMProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, principalKind, principalId])
  @@index([projectId])
  @@index([principalKind, principalId])
  @@map("im_agent_project_memberships")
}

model IMAsset {
  id                  String    @id @default(cuid())
  workspaceId         String
  ownerImUserId       String
  contentHash         String // sha256 of bytes (64 hex chars)
  storageUri          String // 's3://bucket/<hash>' | 'file:///abs/path'
  sizeBytes           BigInt?
  mime                String?
  kind                String    @default("file") // 'file' | 'image' | 'transcript' | 'snippet'
  sourceAgentImUserId String? // 哪个 agent 产的
  sourceTaskId        String? // 哪个 task 产的
  metadata            String    @default("{}") // JSON
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  parentAssetId  String?
  derivationKind String?
  ingestStatus   String  @default("pending")
  ingestVersion  Int     @default(1)
  ingestError    String?
  assetIndexSeq  BigInt  @default(0)
  cdnUrl         String?
  thumbnailUrl   String?
  previewUrls    Json? // JSON: { small?: string, medium?: string, large?: string } | null
  // release202/13 §3b① — thumbHash (base64, ~20-30 bytes) for an instant
  // ~0-network blurred placeholder while the real image loads. Best-effort:
  // null on legacy rows / non-image assets → client falls back to spinner.
  blurHash       String?
  previewAssetId String?
  folderPath     String?
  filename       String?
  sourceRef      String?
  sourceKind     String?
  sourceMetadata String?
  revision       Int     @default(1)
  visibility     String  @default("workspace")
  aclJson        String?
  description    String? // Wave-54 B2: optional agent-authored hint surfaced to other agents

  // release201/09 Phase 2 (migration 434): user-perspective role.
  //   'task-bound' | 'workspace-file' | NULL (legacy, post-backfill 应不再出现)
  boundKind String?

  workspace     IMWorkspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentAsset   IMAsset?          @relation("IMAssetDerivations", fields: [parentAssetId], references: [id])
  derivedAssets IMAsset[]         @relation("IMAssetDerivations")
  previewAsset  IMAsset?          @relation("IMAssetPreview", fields: [previewAssetId], references: [id])
  previewFor    IMAsset[]         @relation("IMAssetPreview")
  revisions     IMAssetRevision[]
  files         IMWorkspaceFile[]

  @@unique([workspaceId, contentHash, sourceRef, deletedAt], map: "uk_im_assets_ws_hash_source_deleted")
  @@index([contentHash])
  @@index([workspaceId, kind])
  @@index([workspaceId, sourceTaskId])
  @@index([workspaceId, deletedAt])
  @@index([workspaceId, assetIndexSeq])
  @@index([workspaceId, sourceRef])
  @@index([workspaceId, ingestStatus])
  @@index([workspaceId, parentAssetId])
  @@index([workspaceId, previewAssetId])
  @@index([workspaceId, boundKind])
  @@map("im_assets")
}

model IMAssetRevision {
  id                  String    @id @default(cuid())
  assetId             String
  workspaceId         String
  revision            Int
  contentHash         String
  storageUri          String
  sizeBytes           BigInt?
  mime                String?
  kind                String
  ownerImUserId       String
  sourceAgentImUserId String?
  sourceTaskId        String?
  metadata            String
  parentAssetId       String?
  derivationKind      String?
  ingestStatus        String
  ingestVersion       Int
  ingestError         String?
  cdnUrl              String?
  thumbnailUrl        String?
  previewUrls         Json?
  previewAssetId      String?
  folderPath          String?
  filename            String?
  sourceRef           String?
  sourceKind          String?
  sourceMetadata      String?
  visibility          String
  aclJson             String?
  description         String?
  deletedAt           DateTime?
  createdByImUserId   String?
  reason              String?
  createdAt           DateTime  @default(now())

  asset IMAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, revision])
  @@index([workspaceId, assetId, revision])
  @@index([workspaceId, createdAt])
  @@map("im_asset_revisions")
}

model IMAssetIndexCounter {
  workspaceId String   @id
  nextSeq     BigInt   @default(1)
  updatedAt   DateTime @updatedAt

  @@map("im_asset_index_counters")
}

// Wave-54 B7: multi-daemon coordination for asset parse work.
// See prisma/schema.mysql.prisma for the canonical definition.
model IMIngestClaim {
  id               String    @id @default(cuid())
  workspaceId      String
  assetId          String
  ingestVersion    Int
  claimantImUserId String
  claimantDeviceId String
  status           String    @default("active")
  claimedAt        DateTime
  heartbeatAt      DateTime
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([workspaceId, assetId, ingestVersion], name: "uq_ingest_claim_target")
  @@index([status, heartbeatAt])
  @@index([claimantImUserId, claimantDeviceId])
  @@map("im_ingest_claims")
}

model IMWorkspaceFile {
  id               String    @id @default(cuid())
  workspaceId      String
  path             String
  assetId          String
  version          Int       @default(1)
  parentVersionId  String? // 历史链 (FK to im_workspace_files.id, 同表自引用)
  modifierImUserId String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  workspace IMWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  asset     IMAsset     @relation(fields: [assetId], references: [id])

  @@unique([workspaceId, path, deletedAt])
  @@index([workspaceId, updatedAt])
  @@index([assetId])
  @@map("im_workspace_files")
}

model IMAgentProfile {
  id            String    @id @default(cuid())
  workspaceId   String
  agentImUserId String // FK → im_users.id (agent role)
  adapterName   String // 'hermes' | 'claude-code' | 'openclaw' | 'codex'
  name          String // 'Project A backend'
  config        String    @default("{}") // JSON: adapter-specific (cwd/model/MCP/env/prompt)
  version       Int       @default(1) // 乐观锁
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  workspace IMWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, agentImUserId, name, deletedAt])
  @@index([workspaceId, agentImUserId])
  @@map("im_agent_profiles")
}

// ==============================================================================
// v1.9.3 — QR pairing offer (m3 phase 2, see 03-ws-protocol.md §pair)
// ==============================================================================

model IMPairingOffer {
  nonce            String    @id // daemon-generated
  devicePub        String? // ed25519 pubkey, anti-replay
  deviceName       String? // 'My MacBook Pro'
  approverImUserId String? // mobile user who approved
  approvedAt       DateTime?
  apiKeyId         String? // new API key minted at approval
  consumedAt       DateTime? // daemon poll consumed it (one-shot)
  expiresAt        DateTime // now + 5min
  createdAt        DateTime  @default(now())

  @@index([expiresAt])
  @@map("im_pairing_offers")
}

// ==============================================================================
// Sandbox (Cloud 3 / S2): Container + Snapshot + RunLog
// ==============================================================================

model IMContainer {
  id            String  @id @default(cuid())
  workspaceId   String
  // Migration 448 (release201/20 §1) — optional project scope for
  // runtime-installation containers. NULL = workspace-level.
  projectId     String?
  tenantId      String
  agentImUserId String?
  taskId        String?

  podName   String @unique
  namespace String @default("default")
  image     String
  imageTag  String

  status String // pending|bound|running|stopping|stopped|errored|provisioning

  // Wave-8 W11 — runtime backing kind. "docker" is the legacy local-daemon-on-EKS
  // path; "k8s" is the wizard-provisioned pod path.
  // §26 B5 Stage 1: parallel `deviceType` field added; future stage retires runtimeKind.
  runtimeKind String @default("docker")

  // §26 B5 Stage 1 — device-semantic fields (migration 317):
  //   deviceType: 'local' | 'k8s' | 'docker-host' | (future) — supersedes runtimeKind
  //   daemonId:   1 device = 1 daemon (nullable in Stage 1)
  deviceType String  @default("k8s")
  daemonId   String?

  // Migration 336 (08 §6.1) — provider abstraction convergence field;
  // replaces the runtimeKind+deviceType pair (kept in parallel during the
  // dual-write window; v210 drops the legacy pair).
  providerKind       String    @default("k8s")
  // Migration 336 (08 §5.4) — daemon /healthz reconciler state.
  // misses≥3 → status=degraded; reset to 0 on a successful probe.
  daemonHealthMisses Int       @default(0)
  lastDaemonHealthAt DateTime?

  // Migration 322 — provisioning progress signals for workspace UI + admin
  // console. provisioningStep is the current step name (null when not in
  // flight); provisioningHistory is a JSON array of step transitions.
  // Column naming follows the camelCase convention shared by the rest of
  // im_containers (runtimeKind, deviceType, agentImUserId, etc.) so no @map.
  provisioningStep    String?
  provisioningHistory Json?

  // Migration 323 — §30 §2.6 device capacity model. Maximum number of agents
  // that can register against this device. Default 3 (Web base subscription
  // tier). Enforcement happens in agent.register (server-side) — schema-only
  // here, read path lands in §30 B3.
  // 2026-06-06 — schema default was still 3 while DB migration 340 bumped the
  // column DEFAULT to 10; Prisma bakes the SCHEMA default into the insert, so
  // every Prisma-created device got 3 → the "maximum is 3" cap. Align to 10.
  maxAgents Int @default(10)

  cpuRequest    String
  cpuLimit      String
  memoryRequest String
  memoryLimit   String

  gatewayUrl String?

  // v2.0 §4.8 (migration 409): daemon transport-probe report.
  transport        String? // 'ws' | 'http' | 'both'
  gatewayIsPrivate Boolean?
  lastProbeAt      DateTime?

  startedAt DateTime?
  stoppedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([workspaceId, status])
  @@index([tenantId])
  @@index([taskId])
  @@index([daemonId])
  @@index([deviceType])
  @@index([provisioningStep])
  @@index([providerKind, status])
  @@index([transport, lastProbeAt])
  // Migration 448 — project scope filter (release201/20 §1).
  @@index([projectId, status])
  @@map("im_containers")
}

model IMContainerSnapshot {
  id             String            @id @default(cuid())
  containerId    String
  // S3 (302): imageTag/imageDigest/sizeBytes set by docker-commit snapshots.
  // Daemon-first FS manifest snapshots leave them null and store the file
  // digest list in `metadata` (kind="fs-manifest").
  imageTag       String?
  imageDigest    String? // sha256:...
  sizeBytes      BigInt?
  createdBy      String // imUserId
  createdAt      DateTime          @default(now())
  metadata       String            @default("{}")
  agentSnapshots IMAgentSnapshot[]

  @@index([containerId, createdAt])
  @@map("im_container_snapshots")
}

model IMAgentSnapshot {
  id                      String   @id @default(cuid())
  agentImUserId           String
  workspaceId             String
  definitionJson          Json
  skillsJson              Json
  containerSnapshotId     String?
  perAgentDirManifestJson Json?
  memoryDumpRef           String?
  includeMemory           Boolean  @default(false)
  createdAt               DateTime @default(now())
  createdBy               String
  status                  String   @default("ready")
  sizeBytes               BigInt?

  containerSnapshot IMContainerSnapshot? @relation(fields: [containerSnapshotId], references: [id], onDelete: SetNull)

  @@index([agentImUserId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([containerSnapshotId])
  @@map("im_agent_snapshots")
}

model IMAgentPackage {
  id                String   @id @default(cuid())
  slug              String   @unique
  version           String
  publisherImUserId String
  publisherDid      String
  definitionJson    Json
  skillsJson        Json
  environmentJson   Json
  metadataJson      Json?
  license           String   @default("proprietary")
  curatedQuality    String   @default("review")
  status            String   @default("active")
  createdAt         DateTime @default(now())

  @@index([publisherImUserId, createdAt])
  @@index([curatedQuality, status])
  @@map("im_agent_packages")
}

model IMSandboxRunLog {
  id          String @id @default(cuid())
  containerId String
  workspaceId String
  tenantId    String

  startedAt     DateTime
  endedAt       DateTime?
  durationMs    Int?
  cpuSeconds    Float?
  memoryGbHours Float?

  trigger String // task | manual
  taskId  String?

  exitReason String? // user_stop | task_complete | error | timeout
  exitCode   Int?

  createdAt DateTime @default(now())

  @@index([tenantId, startedAt])
  @@index([workspaceId, startedAt])
  @@map("im_sandbox_run_logs")
}

// Migration 337 (08 §5.4 + §6.1) — Reconciler resource time series.
// Sampled ~30s. 7-day retention (trim job out of scope).
model IMSandboxResourceSample {
  id            String   @id @default(cuid())
  containerId   String
  sampledAt     DateTime
  cpuUsagePct   Float
  memUsedBytes  BigInt
  memLimitBytes BigInt
  daemonRttMs   Int
  createdAt     DateTime @default(now())

  @@index([containerId, sampledAt])
  @@index([sampledAt])
  @@map("im_sandbox_resource_samples")
}

// Migration 338 (08 §6.1) — Unified run record across ephemeral + persistent
// providers. Supersedes IMSandboxRunLog; kept in parallel during cutover.
// SQLite: executionKind stored as String ('ephemeral' | 'persistent').
// MySQL: backed by SandboxExecutionKind enum.
model IMSandboxRun {
  id                String    @id @default(cuid())
  containerId       String?
  providerKind      String
  executionKind     String // 'ephemeral' | 'persistent'
  workspaceId       String
  tenantId          String?
  taskId            String?
  startedAt         DateTime
  endedAt           DateTime?
  durationMs        Int?
  exitCode          Int?
  exitReason        String?
  cpuSeconds        Float?
  memoryGbHours     Float?
  billedAmountCents Int?
  createdAt         DateTime  @default(now())

  @@index([workspaceId, startedAt])
  @@index([taskId])
  @@index([providerKind, executionKind])
  @@index([exitCode, startedAt])
  @@map("im_sandbox_runs")
}

// Migration 338 (08 §6.1) — per-workspace concurrency + monthly caps.
// Defaults intentionally loose (08 §11) to avoid 503 false-positive at GA.
model IMSandboxQuota {
  workspaceId             String   @id
  maxConcurrentRuns       Int      @default(10)
  maxMonthlyPodHours      Int      @default(1000)
  maxMonthlyEphemeralRuns Int      @default(10000)
  currentPodHours         Float    @default(0)
  currentEphemeralRuns    Int      @default(0)
  rollingWindowStartedAt  DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("im_sandbox_quotas")
}
