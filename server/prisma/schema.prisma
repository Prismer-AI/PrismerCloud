  sourceRoleTemplateSlug String?
  sourceTaskAuthority    String?
  sourceIsOrchestrator   Boolean?

  @@unique([workspaceId, scope, ownerType, ownerId, path])
  @@index([ownerId, ownerType])
  @@index([workspaceId])
  @@index([workspaceId, scope, ownerType, ownerId])
  @@index([workspaceId, sourceRef])
  @@index([agentImUserId, scope])
  @@index([workspaceId, sourceRoleTemplateSlug])
  @@index([workspaceId, sourceIsOrchestrator])
  @@map("im_memory_files")
}

// ==============================================================================
// release201/26 — Conversational Memory (Phase 1 schema; §4 + §5.1)
// ==============================================================================
//
// L2 "Compressed Session" + quote/identifier indices. All tables here are
// DERIVED data over the L1 raw ledger (im_messages): they are NOT signed and
// do not modify any IMMessage row (decision §4 "签名链影响"). Quote ref always
// points at a raw messageId (decision C); rendering resolves to its segment.
// JSON-shaped columns are stored as String (mirrors im_* convention; see
// schema.mysql.prisma for @db.Text native types).

model IMConversationCompressedSegment {
  id             String @id @default(cuid())
  conversationId String
  // Phase 1 only emits 'range'; Topic/Decision/Entity kinds are future (§3 A).
  segmentKind    String @default("range") // range
  segmentSeq     Int

  coversFromMessageId    String
  coversToMessageId      String
  coveredRawMessageIdsJson String   @default("[]") // JSON: string[]
  coversFromCreatedAt    DateTime
  coversToCreatedAt      DateTime

  summary          String   @default("")
  salientFactsJson String   @default("{}") // JSON: { taskEventCount, approvalCount, ... } (§5.1 metric-only)
  tokenCountCl100k Int      @default(0)
  producerModel    String
  producerVersion  String
  supersededBy     String? // segment id that replaced this one (regenerate)

  // §12 forward-ref: reserved for embedding index; substring+alias is Phase 1.
  embeddingRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unique key guards concurrent compaction (§3 + Phase 2 INSERT OR IGNORE).
  @@unique([conversationId, segmentKind, segmentSeq])
  @@index([conversationId])
  @@map("im_conversation_compressed_segments")
}

model IMConversationRawToSegmentIndex {
  id           String @id @default(cuid())
  rawMessageId String
  segmentId    String
  segmentKind  String @default("range")

  createdAt DateTime @default(now())

  @@index([rawMessageId])
  @@index([segmentId])
  @@map("im_conversation_raw_to_segment_index")
}

model IMConversationQuoteCache {
