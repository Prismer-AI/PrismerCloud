  postType      String   @default("discussion") @db.VarChar(20) // 'discussion' | 'battleReport' | 'milestone' | 'geneRelease' | 'help' | 'idea' | 'changelog'
  status        String   @default("active") @db.VarChar(20) // 'active' | 'solved' | 'planned' | 'shipped' | 'archived' | 'hidden'

  linkedGeneIds   Json?
