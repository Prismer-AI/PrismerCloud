  @@index([messageId, chunkSeq])
  @@index([createdAt])
  @@map("im_message_partials")
}

// ==============================================================================
// v1.7.2 — Task Orchestration (Cloud Task Store + Scheduler)
// ==============================================================================

model IMTask {
  id String @id @default(cuid()) @db.VarChar(30)

  // Task content
  title        String  @db.VarChar(255)
  description  String? @db.Text
  capability   String? @db.VarChar(100)
  // Cloud 3 / S3: task execution surface — agent | sandbox | shell
  runtimeRoute String? @default("agent") @db.VarChar(20)
  // Cloud 3 / S3: sandbox execution backref (set by dispatchToSandbox)
  containerId  String? @db.VarChar(30)
  input        String  @default("{}") @db.Text
  contextUri   String? @db.VarChar(500)

  // Participants
  creatorId      String  @db.VarChar(36)
  assigneeId     String? @db.VarChar(36)
  conversationId String? @db.VarChar(36)

  // State machine (v2.0 / release 200 §5.1):
  //   pending → assigned → running → review → completed | failed | cancelled
  //                            ↘ blocked ↗
  // 'blocked' is v2.0 addition — app-layer enum (VARCHAR(20)), see migration 341.
  status        String  @default("pending") @db.VarChar(20)
  // v2.0 §4.2 (migration 403): execution phase decoupled from status. enum
  // values (app-layer): thinking | tool_use | reasoning | responding |
  // waiting_user | waiting_dep | stuck. Reaper writes 'stuck' only — never
  // touches status. Daemon reconnect auto-recovers phase. NULL when status
  // is not running/review.
  currentPhase  String? @db.VarChar(40)
  progress      Float?  @db.Double
  statusMessage String? @db.VarChar(500)
  position      Float?  @db.Double // Kanban order — B-tree midpoint (v2.0 §8 migration 342)

  // Scheduling
  scheduleType     String?   @db.VarChar(20)
  scheduleAt       DateTime? @db.DateTime(3)
  scheduleCron     String?   @db.VarChar(100)
  intervalMs       Int?
  nextRunAt        DateTime? @db.DateTime(3)
  lastRunAt        DateTime? @db.DateTime(3)
  // v2.0 §4.2 (migration 403): daemon-pushed phase heartbeat (~15s). Reaper
  // marks `currentPhase='stuck'` if older than 45s. NOT a substitute for
  // task.timeoutMs which is the task-level safety net.
  lastHeartbeatAt  DateTime? @db.DateTime(3)
  heartbeatVersion BigInt    @default(0) @db.BigInt
  runCount         Int       @default(0)
  maxRuns          Int?

  // Result
  result    String? @db.Text
  resultUri String? @db.VarChar(500)
  error     String? @db.Text

  // Economy
  budget Float? @db.Double
  cost   Float  @default(0) @db.Double

  // Timeout / Retry
  timeoutMs    Int       @default(300000)
  deadline     DateTime? @db.DateTime(3)
  completedAt  DateTime? @db.DateTime(3)
  maxRetries   Int       @default(0)
  retryDelayMs Int       @default(60000)
  retryCount   Int       @default(0)

  // Metadata
  metadata  String   @default("{}") @db.Text
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  logs IMTaskLog[]
  runs IMTaskRun[]

  workspaceId String? @db.VarChar(30) // 1.9.2 Phase 1 (m2 NULLable, m3 NOT NULL + drop scope)

  // release201/09 Phase 2 (migration 433): project scope. NULL = workspace-level
  // (unscoped). Composite index supports board/task-list filter by (project +
  // status). NULL is legal — do NOT add NOT NULL constraint.
  projectId String? @db.VarChar(30)

  // release201/10 (migration 438): acceptance criteria + rolled-up status.
  //   acceptanceCriteriaJson — JSON array of criterion objects (see
  //     TaskAcceptanceService for the shape; §3.2 of release201/10).
  //   acceptanceStatus       — enum (app-layer):
  //     none / pending / partial / passed / failed
  //   Recomputed by TaskAcceptanceService.recomputeStatus (§4.2) on each
  //   verify/update; never set directly by an SQL trigger.
  acceptanceCriteriaJson String? @db.Text
  acceptanceStatus       String  @default("none") @db.VarChar(20)

  @@index([status])
  @@index([assigneeId, status])
  @@index([capability, status])
  @@index([scheduleType, nextRunAt, status])
  @@index([creatorId])
  @@index([creatorId, status])
  @@index([conversationId])
  @@index([completedAt])
  @@index([workspaceId])
  @@index([runtimeRoute, status])
  @@index([containerId])
  @@index([status, lastHeartbeatAt], map: "im_tasks_heartbeat_idx")
  @@index([projectId, status], map: "idx_im_tasks_project_status")
  @@index([acceptanceStatus], map: "idx_acceptance_status")
  @@map("im_tasks")
}

// release201/10 (migration 439): IMTaskCriteriaTemplate
// Stores re-usable acceptance criteria templates keyed by capability.
//   workspaceId IS NULL  → global (Prismer built-in, seeded at cloud boot)
//   workspaceId IS 具体  → workspace-level (owner-defined)
// criteriaJson is the same shape as IMTask.acceptanceCriteriaJson minus
// id/status/verifiedAt (template entries get fresh runtime state on apply).
model IMTaskCriteriaTemplate {
