  @@unique([workspaceId, memberImUserId])
  @@index([memberImUserId])
  @@map("im_workspace_members")
}

// release201/16 Phase 9 — workspace invite token system. Token-bearing rows
// that bridge "I want to add this person" to "this person clicked accept".
// Two flows in one shape (16 §3.2.1):
//   - link invite:    inviteeEmail set, inviteeImUserId null → emailed link
//   - direct request: inviteeImUserId set                    → in-app
// State machine: pending → accepted | rejected | revoked | expired (terminal).
model IMWorkspaceInvite {
  id               String    @id @default(cuid()) @db.VarChar(30)
  workspaceId      String    @db.VarChar(30)
