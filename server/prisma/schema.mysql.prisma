// v2.0 §4.4 / §12.1 (migration 405): runtime activity timeline log — one row
// per phase change / tool call / reasoning chunk / progress / error. seq is
// per-taskRun monotonic (allocated by daemon's StepRecorder). Distinct from
// im_task_logs (business audit axis); front-end merges both by timestamp.
model IMTaskRunStep {
  id          String   @id @db.VarChar(40)
  taskRunId   String   @db.VarChar(40)
  taskId      String   @db.VarChar(40)
  seq         BigInt   @db.BigInt
  kind        String   @db.VarChar(30) // 'phase_change' | 'tool_call' | 'tool_result' | 'reasoning_chunk' | 'progress' | 'error'
  payloadJson Json
  occurredAt  DateTime @db.DateTime(3)
  durationMs  Int?

  @@index([taskRunId, seq], map: "taskrun_seq_idx")
  @@index([taskId, occurredAt], map: "task_occurred_idx")
  @@index([kind, occurredAt], map: "kind_occurred_idx")
  @@map("im_task_run_steps")
}

// v2.0 §4.3 (migration 404): dispatch reply two-phase prepare/commit log.
// prepare: daemon uploads assets + posts metadata → row with status='prepared'.
// commit: daemon posts replyId → cloud writes message + outbox in one tx.
// Duplicate (taskId, idempotencyKey) returns the existing row.
model IMDispatchReply {
  id                 String    @id @db.VarChar(40)
  taskId             String    @db.VarChar(40)
  // Daemon-supplied key, persisted verbatim. Length 255 (migration 419,
  // 2026-05-22) so any namespaced / pair-uuid shape the daemon uses fits.
  idempotencyKey     String    @db.VarChar(255)
  status             String    @db.VarChar(20) // 'prepared' | 'committed' | 'aborted'
  assetIdsJson       Json
  messageContentJson Json?
  metricsJson        Json?
  preparedAt         DateTime  @default(now()) @db.DateTime(3)
  committedAt        DateTime? @db.DateTime(3)
  abortedAt          DateTime? @db.DateTime(3)

  @@unique([taskId, idempotencyKey], map: "uniq_task_idem")
  @@index([status, preparedAt], map: "idx_status_prepared_at")
  @@map("im_dispatch_replies")
}

// v2.0 §4.5 (migration 408): persistent WS ack tracker — survives Pod
// restart / drift. WS reconnect catch-up: SELECT WHERE userId=? AND
// ackedAt IS NULL AND createdAt > <cursor>.
model IMWSAck {
  id          String    @id @db.VarChar(40)
  userId      String    @db.VarChar(40)
  ackId       String    @db.VarChar(64)
  payloadJson Json
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  ackedAt     DateTime? @db.DateTime(3)

  @@index([userId, ackedAt], map: "user_pending_idx")
  @@index([userId, ackId], map: "user_ack_idx")
  @@index([createdAt], map: "created_idx")
  @@map("im_ws_acks")
}

// v2.0 §4.8.2 (migration 410): explicit multi-daemon binding ownership.
// Replaces the silent reject in ws/handler.ts:611 — contested writes a
// marker + sync event so the user can see & rebind via /agent-bindings APIs.
// See §1.5 jasonzhou production case study for the smoking-gun motivation.
model IMAgentBinding {
  id                String    @id @db.VarChar(40)
  agentImUserId     String    @unique(map: "uniq_agent") @db.VarChar(40)
  boundDaemonId     String    @db.VarChar(60)
  boundDaemonKind   String    @db.VarChar(20) // 'k8s' | 'local' | 'edge'
  boundDaemonLabel  String    @db.VarChar(100)
  boundAt           DateTime  @default(now()) @db.DateTime(3)
  boundBy           String    @db.VarChar(30) // 'auto-first-declare' | 'user-explicit' | 'cloud-rebalance' | 'transfer'
  lastHostDeclareAt DateTime  @default(now()) @db.DateTime(3)
  lastDispatchAt    DateTime? @db.DateTime(3)
  contestedSince    DateTime? @db.DateTime(3)
  contestCount      Int       @default(0)
  // release201/09 §9.7 Phase 3 (migration 435) — agent transfer quiesce.
  // NULL = active dispatch; non-NULL = paused (transfer in progress or admin
  // hold). Cloud dispatch loop SKIPs paused agents; SDK `agent transfer`
  // sets this, then clears after rebind.
  pausedAt          DateTime? @db.DateTime(3)
  // release201/09 §9.7 Phase 3 (migration 443) — 3-stage transfer protocol.
  // Mirrors /api/im/agent-transfer/{initiate,complete,abort} state machine:
  //   'idle'      → no in-flight transfer (default)
  //   'initiated' → transferToDaemonId is the target; source has quiesced,
  //                 tarball generated, target daemon yet to confirm import
  //   'completed' → resets to 'idle' atomically after rebind lands
  //   'aborted'   → resets to 'idle' atomically; boundDaemonId untouched
  // 'completed' / 'aborted' are emitted only as sync_events; the column
  // itself returns to 'idle' immediately for steady-state consistency.
  transferState       String?   @default("idle") @db.VarChar(20)
  transferToDaemonId  String?   @db.VarChar(60)
  transferInitiatedAt DateTime? @db.DateTime(3)

  @@index([boundDaemonId], map: "bound_daemon_idx")
  @@index([contestedSince], map: "contested_idx")
  @@index([lastDispatchAt], map: "last_dispatch_idx")
  @@map("im_agent_bindings")
}

// ─── ACP Human Approval Inbox ───────────────────────────────
model IMApproval {
  id             String    @id @default(cuid()) @db.VarChar(30)
  workspaceId    String    @db.VarChar(30)
  conversationId String?   @db.VarChar(36)
  taskId         String?   @db.VarChar(30)
