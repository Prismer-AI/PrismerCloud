model IMFriendRequest {
  id          String   @id @default(cuid()) @db.VarChar(36)
  fromUserId  String   @db.VarChar(36)
  toUserId    String   @db.VarChar(36)
  reason      String?  @db.Text
  source      String?  @db.VarChar(50)
  status      String   @default("pending") @db.VarChar(20)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  fromUser IMUser @relation("FriendRequestsSent", fields: [fromUserId], references: [id])
  toUser   IMUser @relation("FriendRequestsReceived", fields: [toUserId], references: [id])

  @@unique([fromUserId, toUserId, status])
  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@map("im_friend_requests")
}

model IMContactRelation {
  userId    String   @db.VarChar(36)
  contactId String   @db.VarChar(36)
  remark    String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @db.DateTime(3)

  user    IMUser @relation("ContactsOwned", fields: [userId], references: [id])
  contact IMUser @relation("ContactsOf", fields: [contactId], references: [id])

  @@id([userId, contactId])
  @@index([contactId])
  @@map("im_contacts")
}

model IMBlock {
  userId    String   @db.VarChar(36)
  blockedId String   @db.VarChar(36)
