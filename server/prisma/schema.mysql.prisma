// ==============================================================================
// Prismer Cloud - IM Server MySQL Schema
// ==============================================================================
//
// MySQL variant of schema.prisma for test/production environments.
// Matches tables created by src/im/sql/001-012 migrations.
//
// IMPORTANT:
// - Do NOT use `prisma db push` with this schema (tables managed by SQL migrations)
// - Generate client: npx prisma generate --schema=prisma/schema.mysql.prisma
// - im_credits / im_credit_transactions are EXCLUDED (dev-only, prod uses pc_* tables)
//
// ==============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "./generated/mysql"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// IM 用户
// ==============================================================================

model IMUser {
  id           String   @id @default(cuid()) @db.VarChar(30)
  username     String   @unique @db.VarChar(100)
  displayName  String   @db.VarChar(200)
  passwordHash String?  @db.VarChar(255)
  role         String   @default("human") @db.VarChar(20)
  agentType    String?  @db.VarChar(30)
  avatarUrl    String?  @db.VarChar(500)
  metadata     String?  @db.Text
  userId       String?  @db.VarChar(50)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)

  // Security (v1.7.2)
  trustTier       Int       @default(0)
  violationCount  Int       @default(0)
  suspendedUntil  DateTime? @db.DateTime(3)
  lastViolationAt DateTime? @db.DateTime(3)
  // Moderation (v1.7.3)
  reportBanUntil  DateTime? @db.DateTime(3)
  quarantineCount Int       @default(0)
  publishCount    Int       @default(0)
  banned          Boolean   @default(false)
  bannedAt        DateTime? @db.DateTime(3)
  banReason       String?   @db.VarChar(500)
  // AIP Layer 1: DID identity
  primaryDid      String?   @unique @db.VarChar(128)
  delegatedBy     String?   @db.VarChar(128)

  // Contact system (v1.8.0 P9)
  institution String?   @db.VarChar(200)
  description String?   @db.VarChar(500)
  lastSeenAt  DateTime? @db.DateTime(3)

  // Native Auth (v1.9.4) — replaces Go-backend `prismer_info.users` for new accounts
  email         String? @unique @db.VarChar(255)
  phone         String? @unique @db.VarChar(20)
  googleId      String? @unique @db.VarChar(64)
  githubId      String? @unique @db.VarChar(64)
  appleId       String? @unique @db.VarChar(128)
  twitterId     String? @unique @db.VarChar(64)
  emailVerified Boolean @default(false)
  numericId     BigInt? @unique @default(autoincrement()) @db.UnsignedBigInt

  agentCard                IMAgentCard?
  identityKey              IMIdentityKey?
  participations           IMParticipant[]
  sentMessages             IMMessage[]
  createdConversations     IMConversation[]
  readCursors              IMReadCursor[]
  bindings                 IMBinding[]
  channelAccountsOwned     IMChannelAccount[]   @relation("ChannelAccountOwner")
  externalIdentitiesLinked IMExternalIdentity[] @relation("ExternalIdentityLink")
  fileUploads              IMFileUpload[]

  // Contact system relations (v1.8.0 P9)
  friendRequestsSent     IMFriendRequest[]   @relation("FriendRequestsSent")
  friendRequestsReceived IMFriendRequest[]   @relation("FriendRequestsReceived")
  contactsOwned          IMContactRelation[] @relation("ContactsOwned")
  contactsOf             IMContactRelation[] @relation("ContactsOf")
  blocksOwned            IMBlock[]           @relation("BlocksOwned")
  blockedBy              IMBlock[]           @relation("BlockedBy")

  @@index([role])
  @@index([userId])
  @@index([primaryDid])
  @@index([email])
  @@index([numericId])
  @@map("im_users")
}

// ==============================================================================
// Agent 名片 (能力声明)
// ==============================================================================

model IMAgentCard {
  id              String    @id @default(cuid()) @db.VarChar(30)
  imUserId        String    @unique @db.VarChar(30)
  name            String    @db.VarChar(200)
  description     String    @default("") @db.Text
  agentType       String    @default("assistant") @db.VarChar(30)
  capabilities    String    @default("[]") @db.Text
  protocolVersion String    @default("1.0") @db.VarChar(20)
  endpoint        String?   @db.VarChar(500)
  metadata        String    @default("{}") @db.Text
  lastHeartbeat   DateTime? @db.DateTime(3)
  status          String    @default("offline") @db.VarChar(20)
  load            Float     @default(0) @db.Double
  createdAt       DateTime  @default(now()) @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @db.DateTime(3)

  // AIP Layer 2: DID Document
  did            String? @db.VarChar(128)
  didDocumentUrl String? @db.VarChar(512)

  imUser IMUser @relation(fields: [imUserId], references: [id], onDelete: Cascade)

  workspaceId String @db.VarChar(30) // 1.9.2 Phase 2: workspace-owned memory

  @@index([status])
  @@index([workspaceId])
  @@map("im_agent_cards")
}

// ==============================================================================
// AIP Layer 3-4: Agent Credentials, DID Mappings, Revocation
// ==============================================================================

model IMAgentCredential {
  id             String    @id @default(cuid()) @db.VarChar(30)
  holderDid      String    @db.VarChar(128)
  credentialType String    @db.VarChar(50)
  issuerDid      String    @db.VarChar(128)
  credential     String    @db.MediumText
  validFrom      DateTime  @db.DateTime(3)
  validUntil     DateTime? @db.DateTime(3)
  revoked        Boolean   @default(false)
  createdAt      DateTime  @default(now()) @db.DateTime(3)

  @@index([holderDid])
  @@index([issuerDid])
  @@index([credentialType])
  @@map("im_agent_credentials")
}

model IMDIDMapping {
  id        String   @id @default(cuid()) @db.VarChar(30)
  did       String   @unique @db.VarChar(128)
  imUserId  String   @db.VarChar(30)
  didMethod String   @db.VarChar(10)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([imUserId])
  @@map("im_did_mappings")
}

model IMRevocationEntry {
  id              String   @id @default(cuid()) @db.VarChar(30)
  issuerDid       String   @db.VarChar(128)
  targetDid       String   @db.VarChar(128)
  credentialId    String?  @db.VarChar(128)
  reason          String   @db.VarChar(500)
  statusListIndex Int
  createdAt       DateTime @default(now()) @db.DateTime(3)

  @@unique([issuerDid, targetDid, credentialId])
  @@index([targetDid])
  @@map("im_revocation_entries")
}

// ==============================================================================
// 对话
// ==============================================================================

model IMConversation {
  id            String    @id @default(cuid()) @db.VarChar(30)
  type          String    @default("direct") @db.VarChar(20)
  title         String?   @db.VarChar(255)
  description   String?   @db.Text
  status        String    @default("active") @db.VarChar(20)
  metadata      String    @default("{}") @db.Text // JSON: extra data; built-ins use metadata.source='built-in'
  createdById   String    @db.VarChar(30)
  workspaceId   String?   @db.VarChar(50) // 1.9.x: 1 ws → N conversations，去掉 1.8.2 误加的 @unique
  lastMessageAt DateTime? @db.DateTime(3)
  createdAt     DateTime  @default(now()) @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @db.DateTime(3)

  createdBy        IMUser              @relation(fields: [createdById], references: [id])
  participants     IMParticipant[]
  messages         IMMessage[]
  readCursors      IMReadCursor[]
  externalRoutings IMExternalRouting[] @relation("ExternalRoutings")

  @@index([status])
  @@index([createdById])
  @@index([lastMessageAt])
  @@index([workspaceId])
  @@map("im_conversations")
}

// ==============================================================================
// 参与者
// ==============================================================================

model IMParticipant {
  id             String    @id @default(cuid()) @db.VarChar(30)
  conversationId String    @db.VarChar(30)
  imUserId       String    @db.VarChar(30)
  role           String    @default("member") @db.VarChar(20)
  joinedAt       DateTime  @default(now()) @db.DateTime(3)
  leftAt         DateTime? @db.DateTime(3)
  pinned         Boolean   @default(false)
  muted          Boolean   @default(false)
  pinnedAt       DateTime? @db.DateTime(3)

  conversation IMConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  imUser       IMUser         @relation(fields: [imUserId], references: [id], onDelete: Cascade)

  @@unique([conversationId, imUserId])
  @@index([imUserId])
  @@map("im_participants")
}

// ==============================================================================
// 消息
// ==============================================================================

model IMMessage {
  id                String   @id @default(cuid()) @db.VarChar(30)
  conversationId    String   @db.VarChar(30)
  senderId          String   @db.VarChar(30)
  type              String   @default("text") @db.VarChar(30)
  content           String   @default("") @db.LongText
  metadata          String   @default("{}") @db.Text
  attachments       Json?
  // v2.0 §4.6 / 14b §4.1 (migration 406): canonical multimodal payload as
  // ContentBlock[] (text | image | audio | video | file | tool_use |
  // tool_result | reasoning). `content` + `attachments` remain readable for
  // ≥6 sprints of dual-write before retirement.
  contentBlocksJson Json?
  // v2.0 §4.1 (migration 402 + 419): first-class idempotencyKey for POST /messages.
  // (conversationId, idempotencyKey) UNIQUE — race-safe at DB layer. Length 255
  // (migration 419, 2026-05-22) to accommodate the legacy /dispatch/reply
  // path's namespaced shape `dispatch_reply:{convId}:{msgId}:{agentId}` which
  // can be ~92 chars with cuid IDs; see evidence/14-g2-idempotency-overflow.md.
  idempotencyKey    String?  @db.VarChar(255)
  parentId          String?  @db.VarChar(30)
  quotedMessageId   String?  @db.VarChar(30)
  status            String   @default("sent") @db.VarChar(20)
  createdAt         DateTime @default(now()) @db.DateTime(3)
  updatedAt         DateTime @updatedAt @db.DateTime(3)

  // E2E Encryption Layer 2: Signing & Integrity (v1.7.2)
  secVersion  Int?
  senderKeyId String? @db.VarChar(16)
  sequence    Int?
  contentHash String? @db.VarChar(64)
  prevHash    String? @db.VarChar(64)
  signature   String? @db.Text

  // AIP Layer 2: DID-based signing
  senderDid       String? @db.VarChar(128)
  delegationProof String? @db.MediumText

  // E2E Layer 5: encryption first-class field (S5 fix)
  encrypted Boolean @default(false)

  // release201/26 §4 §6 §10 (migration 455) — cl100k (tiktoken) token count.
  // Nullable: backfilled lazily by the conversational-memory worker (§8 Phase 1);
  // NULL until counted. Cloud budgets context in cl100k units (§6); adapters
  // convert to their native tokenizer. Backfill never invalidates signatures —
  // the canonical signing strings (crypto/index.ts:175-232) do not include
  // token-count fields, and contentHash hashes content only.
  tokenCountCl100k Int? @db.Int

  conversation IMConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       IMUser              @relation(fields: [senderId], references: [id])
  reactions    IMMessageReaction[]

  @@unique([conversationId, idempotencyKey], map: "im_messages_idem")
  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@index([parentId])
  @@index([quotedMessageId])
  @@index([senderDid])
  @@index([conversationId, senderId, sequence])
  @@map("im_messages")
}

// ==============================================================================
// release201/26 Conversational Memory Phase 1 — derived tables (migrations 450-454)
// ==============================================================================
//
// 5 derived tables that mirror raw `im_messages` for L2 compressed-session
// rendering, quote snapshot, and entity resolution. All DERIVED data — not
// signed, not folded into any signature canonical string. Population /
// consumption details live in `docs/release201/26-conversational-memory-plan.md`.
//
// Relations to IMConversation / IMMessage are intentionally NOT declared:
// these tables are append-only derived rows owned by the memory worker, not
// by the conversation lifecycle, and we don't want Prisma's cascading-delete
// machinery touching them when a conversation is soft-deleted (the memory
// worker has its own GC story).

/// migration 450 — L2 compressed-session segment over the raw ledger.
model IMConversationCompressedSegment {
  id                       String   @id @default(cuid()) @db.VarChar(30)
  conversationId           String   @db.VarChar(30)
  /// Phase 1: 'range' only. Topic / Decision / Entity kinds are §12 future.
  segmentKind              String   @default("range") @db.VarChar(20)
  segmentSeq               Int
  coversFromMessageId      String   @db.VarChar(30)
  coversToMessageId        String   @db.VarChar(30)
  /// JSON-encoded string[] of raw messageIds covered by this segment.
  coveredRawMessageIdsJson String   @db.Text
  coversFromCreatedAt      DateTime @db.DateTime(3)
  coversToCreatedAt        DateTime @db.DateTime(3)
  summary                  String   @db.Text
  /// JSON-encoded metric-only counts (§5.1).
  salientFactsJson         String   @db.Text
  tokenCountCl100k         Int      @default(0)
  producerModel            String   @db.VarChar(100)
  producerVersion          String   @db.VarChar(100)
  /// Segment id that replaced this on regenerate (NULL when current).
  supersededBy             String?  @db.VarChar(30)
  /// §12 future embedding-index ref; NULL in Phase 1.
  embeddingRef             String?  @db.VarChar(255)
  createdAt                DateTime @default(now()) @db.DateTime(3)
  updatedAt                DateTime @updatedAt @db.DateTime(3)

  @@unique([conversationId, segmentKind, segmentSeq], map: "im_conv_compressed_seg_uk")
  @@index([conversationId], map: "idx_im_conv_compressed_seg_conv")
  @@map("im_conversation_compressed_segments")
}

/// migration 451 — reverse index raw messageId → owning compressed segment.
model IMConversationRawToSegmentIndex {
  id           String   @id @default(cuid()) @db.VarChar(30)
  rawMessageId String   @db.VarChar(30)
  segmentId    String   @db.VarChar(30)
  segmentKind  String   @default("range") @db.VarChar(20)
  createdAt    DateTime @default(now()) @db.DateTime(3)

  @@index([rawMessageId], map: "idx_im_conv_raw_to_seg_raw")
  @@index([segmentId], map: "idx_im_conv_raw_to_seg_seg")
  @@map("im_conversation_raw_to_segment_index")
}

/// migration 452 — quoted-message snapshot (survives source deletion, §10).
model IMConversationQuoteCache {
  id                String    @id @db.VarChar(30)
  quotingMessageId  String    @db.VarChar(30)
  quotedMessageId   String    @db.VarChar(30)
  /// Frozen body — survives source raw-msg deletion.
  snapshotContent   String    @db.Text
  snapshotSender    String    @db.VarChar(128)
  snapshotCreatedAt DateTime  @db.DateTime(3)
  /// Set when the source raw msg is deleted (render "(source deleted at X)").
  sourceDeletedAt   DateTime? @db.DateTime(3)
  conversationId    String    @db.VarChar(30)
  createdAt         DateTime  @default(now()) @db.DateTime(3)

  @@unique([quotingMessageId, quotedMessageId], map: "im_conv_quote_cache_uk")
  @@index([quotedMessageId], map: "idx_im_conv_quote_cache_quoted")
  @@index([conversationId], map: "idx_im_conv_quote_cache_conv")
  @@map("im_conversation_quote_cache")
}

/// migration 453 — reverse lookup "which messages quoted message X".
model IMConversationQuoteBackref {
  id               String   @id @db.VarChar(30)
  quotedMessageId  String   @db.VarChar(30)
  quotingMessageId String   @db.VarChar(30)
  conversationId   String   @db.VarChar(30)
  createdAt        DateTime @default(now()) @db.DateTime(3)

  @@unique([quotedMessageId, quotingMessageId], map: "im_conv_quote_backref_uk")
  @@index([quotedMessageId], map: "idx_im_conv_quote_backref_quoted")
  @@map("im_conversation_quote_backrefs")
}

/// migration 454 — entity name → canonical id resolution per conversation.
model IMConversationIdentifierIndex {
  id                      String   @id @db.VarChar(30)
  conversationId          String   @db.VarChar(30)
  /// 'person' | 'entity' | 'artifact' | …
  identifierKind          String   @db.VarChar(32)
  canonicalId             String   @db.VarChar(255)
  /// JSON-encoded string[] of observed surface forms.
  aliasesJson             String   @db.Text
  firstSeenMessageId      String   @db.VarChar(30)
  lastReferencedMessageId String   @db.VarChar(30)
  displayLabel            String?  @db.VarChar(255)
  /// JSON-encoded free-form metadata.
  metadataJson            String   @db.Text
  createdAt               DateTime @default(now()) @db.DateTime(3)
  updatedAt               DateTime @updatedAt @db.DateTime(3)

  @@unique([conversationId, identifierKind, canonicalId], map: "im_conv_identifier_uk")
  @@index([conversationId], map: "idx_im_conv_identifier_conv")
  @@map("im_conversation_identifier_index")
}

// ==============================================================================
// 消息反应 (Reactions, v1.8.2)
// ==============================================================================

model IMMessageReaction {
  id        String   @id @default(cuid()) @db.VarChar(30)
  messageId String   @db.VarChar(30)
  userId    String   @db.VarChar(36)
  emoji     String   @db.VarChar(32)
  createdAt DateTime @default(now()) @db.DateTime(3)

  message IMMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
  @@map("im_message_reactions")
}

// ==============================================================================
// 已读位置追踪
// ==============================================================================

model IMReadCursor {
  id             String   @id @default(cuid()) @db.VarChar(30)
  conversationId String   @db.VarChar(30)
  imUserId       String   @db.VarChar(30)
  lastReadAt     DateTime @default(now()) @db.DateTime(3)
  lastReadMsgId  String?  @db.VarChar(30)
  createdAt      DateTime @default(now()) @db.DateTime(3)
  updatedAt      DateTime @updatedAt @db.DateTime(3)

  conversation IMConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  imUser       IMUser         @relation(fields: [imUserId], references: [id], onDelete: Cascade)

  @@unique([conversationId, imUserId])
  @@index([imUserId])
  @@map("im_read_cursors")
}

// ==============================================================================
// Webhook 配置
// ==============================================================================

model IMWebhook {
  id            String    @id @default(cuid()) @db.VarChar(30)
  url           String    @db.VarChar(500)
  events        String    @default("[]") @db.Text
  secret        String?   @db.VarChar(100)
  active        Boolean   @default(true)
  createdById   String    @db.VarChar(30)
  failureCount  Int       @default(0)
  lastTriggered DateTime? @db.DateTime(3)
  createdAt     DateTime  @default(now()) @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @db.DateTime(3)

  @@index([active])
  @@map("im_webhooks")
}

// ==============================================================================
// v0.3.0 — 社交平台绑定
// ==============================================================================

model IMBinding {
  id       String @id @default(cuid()) @db.VarChar(30)
  imUserId String @db.VarChar(30)
  platform String @db.VarChar(30)
  status   String @default("pending") @db.VarChar(20)

  externalId   String? @db.VarChar(200)
  externalName String? @db.VarChar(200)

  botToken   String? @db.VarChar(500)
  webhookUrl String? @db.VarChar(500)
  channelId  String? @db.VarChar(100)

  verificationCode String?   @db.VarChar(10)
  verifiedAt       DateTime? @db.DateTime(3)

  capabilities String @default("[]") @db.Text
  config       String @default("{}") @db.Text

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  imUser         IMUser            @relation(fields: [imUserId], references: [id], onDelete: Cascade)
  bridgeMessages IMBridgeMessage[]

  @@unique([imUserId, platform])
  @@index([platform, status])
  @@map("im_bindings")
}

// ==============================================================================
// v0.3.0 — 消息桥接记录
// ==============================================================================

model IMBridgeMessage {
  id                 String  @id @default(cuid()) @db.VarChar(30)
  bindingId          String  @db.VarChar(30)
  channelAccountId   String? @db.VarChar(30)
  externalIdentityId String? @db.VarChar(30)
  direction          String  @db.VarChar(10)

  imMessageId      String? @db.VarChar(30)
  imConversationId String? @db.VarChar(30)

  externalMessageId String? @db.VarChar(200)
  externalGroupId   String? @db.VarChar(200)

  status       String  @default("sent") @db.VarChar(20)
  errorMessage String? @db.Text

  createdAt DateTime @default(now()) @db.DateTime(3)

  binding          IMBinding           @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  channelAccount   IMChannelAccount?   @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  externalIdentity IMExternalIdentity? @relation(fields: [externalIdentityId], references: [id], onDelete: SetNull)

  @@index([bindingId])
  @@index([channelAccountId, direction, createdAt])
  @@index([externalMessageId])
  @@index([imMessageId])
  @@map("im_bridge_messages")
}

// ==============================================================================
// v2.0.0 — External channel accounts and routing
// ==============================================================================

model IMChannelAccount {
  id                String    @id @default(cuid()) @db.VarChar(30)
  ownerImUserId     String    @db.VarChar(30)
  workspaceId       String?   @db.VarChar(30)
  platform          String    @db.VarChar(30)
  label             String    @db.VarChar(200)
  status            String    @default("pending") @db.VarChar(20)
  credentials       String    @default("{}") @db.Text
  accountIdentifier String?   @db.VarChar(200)
  lastConnectedAt   DateTime? @db.DateTime(3)
  lastErrorMessage  String?   @db.Text
  capabilities      String    @default("{}") @db.Text
  config            String    @default("{}") @db.Text
  createdAt         DateTime  @default(now()) @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @db.DateTime(3)

  owner              IMUser               @relation("ChannelAccountOwner", fields: [ownerImUserId], references: [id], onDelete: Cascade)
  workspace          IMWorkspace?         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  externalIdentities IMExternalIdentity[]
  bridgeMessages     IMBridgeMessage[]

  @@index([ownerImUserId, platform])
  @@index([workspaceId, platform])
  @@index([platform, status])
  @@map("im_channel_accounts")
}

model IMExternalIdentity {
  id               String    @id @default(cuid()) @db.VarChar(30)
  channelAccountId String    @db.VarChar(30)
  externalUserId   String    @db.VarChar(200)
  externalName     String?   @db.VarChar(200)
  avatarUrl        String?   @db.Text
  linkedImUserId   String?   @db.VarChar(30)
  linkedAt         DateTime? @db.DateTime(3)
  linkSource       String?   @db.VarChar(50)
  lastContextToken String?   @db.VarChar(512)
  tokenExpiresAt   DateTime? @db.DateTime(3)
  firstSeenAt      DateTime  @default(now()) @db.DateTime(3)
  lastSeenAt       DateTime  @default(now()) @db.DateTime(3)
  metadata         String    @default("{}") @db.Text

  channelAccount IMChannelAccount    @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  linkedImUser   IMUser?             @relation("ExternalIdentityLink", fields: [linkedImUserId], references: [id], onDelete: SetNull)
  routings       IMExternalRouting[]
  bridgeMessages IMBridgeMessage[]

  @@unique([channelAccountId, externalUserId])
  @@index([linkedImUserId])
  @@index([tokenExpiresAt])
  @@map("im_external_identities")
}

model IMExternalRouting {
  id                 String    @id @default(cuid()) @db.VarChar(30)
  externalIdentityId String    @db.VarChar(30)
  conversationId     String    @db.VarChar(30)
  isDefault          Boolean   @default(false)
  lastInboundAt      DateTime? @db.DateTime(3)
  lastOutboundAt     DateTime? @db.DateTime(3)
  createdAt          DateTime  @default(now()) @db.DateTime(3)

  externalIdentity IMExternalIdentity @relation(fields: [externalIdentityId], references: [id], onDelete: Cascade)
  conversation     IMConversation     @relation("ExternalRoutings", fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([externalIdentityId, conversationId])
  @@index([externalIdentityId, isDefault])
  @@index([conversationId])
  @@map("im_external_routings")
}

// ==============================================================================
// v1.6.0 — Context Cache (Prisma-first, replaces backend context_data)
// ==============================================================================

model ContextCache {
  id          String    @id @default(cuid()) @db.VarChar(30)
  userId      String    @db.VarChar(50)
  rawLink     String    @db.Text
  rawLinkHash String    @unique @db.VarChar(64) // SHA-256 hex = 64 chars
  contentUri  String?   @db.VarChar(500)
  hqccContent String    @default("") @db.LongText // Up to ~4GB (100MB gate at service layer)
  intrContent String?   @db.LongText // Up to ~4GB
  visibility  String    @default("private") @db.VarChar(20)
