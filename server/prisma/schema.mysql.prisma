}

// v2.0 §4.1 (migration 401): per-conversation monotonic seq counter.
// Used with `INSERT ... VALUES (?, LAST_INSERT_ID(1)) ON DUPLICATE KEY UPDATE
// seq = LAST_INSERT_ID(seq + 1); SELECT LAST_INSERT_ID()` inside
// prisma.$transaction. NEVER call outside a tx — LAST_INSERT_ID is per-session.
model IMConversationSeq {
  conversationId String @id @db.VarChar(30)
  seq            BigInt @default(0) @db.BigInt

  @@map("im_conversation_seq")
}

// v2.0 §4.4.7 (migration 417): streaming partial render chunks.
// One row per `stream.service` flush tick (~200ms granularity). The chunk
