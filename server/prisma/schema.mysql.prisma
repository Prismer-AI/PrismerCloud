  conversationId String?   @db.VarChar(30)
  // v2.0 §4.1 (migration 401): per-conversation monotonic seq for client gap
  // detection. Allocated atomically via im_conversation_seq counter table
  // using LAST_INSERT_ID(1) inside prisma.$transaction.
  boundarySeq    BigInt?   @db.BigInt
  imUserId       String    @db.VarChar(30)
