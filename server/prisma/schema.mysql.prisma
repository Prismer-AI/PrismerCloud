  // return the existing approval instead of spamming the queue.
  intentHash     String?   @db.VarChar(64)
  title          String    @db.VarChar(255)
  context        String?   @db.Text
  options        String    @db.Text
  status         String    @default("pending") @db.VarChar(20)
  selectedValue  String?   @db.VarChar(100)
  metadata       String    @db.Text
  expiresAt      DateTime? @db.DateTime(3)
  decidedAt      DateTime? @db.DateTime(3)
  createdAt      DateTime  @default(now()) @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @db.DateTime(3)

  @@index([workspaceId, status, createdAt])
  @@index([conversationId, status, createdAt])
  @@index([taskId, status])
  @@index([requestedById, createdAt])
  @@index([decidedById, decidedAt])
  @@index([workspaceId, conversationId, intentHash, status], map: "intent_idx")
  @@map("im_approvals")
}

