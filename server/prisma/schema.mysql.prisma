// Migration 337 (08 §5.4 + §6.1) — Reconciler-driven per-container resource
// time series. Sampled ~30s in the reconciler loop. Retained 7 days then
// trimmed by a maintenance job (out of scope of v200 schema work).
model IMSandboxResourceSample {
  id            String   @id @default(cuid()) @db.VarChar(30)
  containerId   String   @db.VarChar(30)
  sampledAt     DateTime @db.DateTime(3)
  cpuUsagePct   Float
  memUsedBytes  BigInt
  memLimitBytes BigInt
  daemonRttMs   Int
  createdAt     DateTime @default(now()) @db.DateTime(3)

  @@index([containerId, sampledAt])
  @@index([sampledAt])
  @@map("im_sandbox_resource_samples")
}

// Migration 338 (08 §6.1) — Unified run record across ephemeral + persistent
// providers. Supersedes IMSandboxRunLog; kept in parallel during cutover.
// containerId is NULL for ephemeral runs (no pod is provisioned).
enum SandboxExecutionKind {
  ephemeral
  persistent
}

model IMSandboxRun {
  id                String               @id @default(cuid()) @db.VarChar(30)
  containerId       String?              @db.VarChar(30)
  providerKind      String               @db.VarChar(64)
  executionKind     SandboxExecutionKind
  workspaceId       String               @db.VarChar(30)
  tenantId          String?              @db.VarChar(64)
  taskId            String?              @db.VarChar(30)
  startedAt         DateTime             @db.DateTime(3)
  endedAt           DateTime?            @db.DateTime(3)
  durationMs        Int?
  exitCode          Int?
  exitReason        String?              @db.VarChar(255)
  cpuSeconds        Float?
  memoryGbHours     Float?
  billedAmountCents Int?
  createdAt         DateTime             @default(now()) @db.DateTime(3)

  @@index([workspaceId, startedAt])
  @@index([taskId])
  @@index([providerKind, executionKind])
  @@index([exitCode, startedAt])
  @@map("im_sandbox_runs")
}

// Migration 338 (08 §6.1) — Per-workspace concurrency + monthly caps.
// Defaults are intentionally loose (08 §11 risk register) so v200 rollout
// cannot generate 503 false positives. No FK on workspaceId — workspace PK
// convention varies across migrations.
model IMSandboxQuota {
  workspaceId             String   @id @db.VarChar(30)
  maxConcurrentRuns       Int      @default(10)
  maxMonthlyPodHours      Int      @default(1000)
  maxMonthlyEphemeralRuns Int      @default(10000)
  currentPodHours         Float    @default(0)
  currentEphemeralRuns    Int      @default(0)
  rollingWindowStartedAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt               DateTime @updatedAt @db.DateTime(3)

  @@map("im_sandbox_quotas")
}
