  workspaceId  String?  @map("workspace_id") @db.VarChar(30)
  capability   String   @db.VarChar(100)
  name         String   @db.VarChar(128)
  description  String?  @db.Text
  criteriaJson String   @map("criteria_json") @db.Text
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([workspaceId, capability], map: "idx_ws_capability")
  @@index([capability], map: "idx_capability")
  @@index([capability, isDefault], map: "idx_default")
  @@map("im_task_criteria_templates")
}

model IMTaskLog {
