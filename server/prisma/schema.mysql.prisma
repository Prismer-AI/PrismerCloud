  @@id([userId, blockedId])
  @@map("im_blocks")
}

// ==============================================================================
// v1.9.x Workspace Data Model (Track A m1, migration 100)
// ==============================================================================
// 1.9.x 阶段 Workspace 是 first-class 用户数据上下文，1:1 with IMUser。
// 详见 docs/refactor/02-workspace-data-model.md

model IMWorkspace {
  id            String    @id @default(cuid()) @db.VarChar(30)
  ownerImUserId String    @db.VarChar(30)
  name          String    @db.VarChar(128)
  slug          String    @db.VarChar(64)
  isDefault     Boolean   @default(false)
  metadata      String    @default("{}") @db.Text
  createdAt     DateTime  @default(now()) @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @db.DateTime(3)
  deletedAt     DateTime? @db.DateTime(3)

  members       IMWorkspaceMember[]
  agentProfiles IMAgentProfile[]
  assets        IMAsset[]
  files         IMWorkspaceFile[]

  @@unique([ownerImUserId, slug, deletedAt])
  @@index([ownerImUserId, isDefault])
  @@map("im_workspaces")
}

model IMWorkspaceMember {
  id             String   @id @default(cuid()) @db.VarChar(30)
  workspaceId    String   @db.VarChar(30)
  memberImUserId String   @db.VarChar(30)
  role           String   @db.VarChar(32)              // 'owner' | 'admin' | 'member'
  joinedAt       DateTime @default(now()) @db.DateTime(3)

  workspace IMWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, memberImUserId])
  @@index([memberImUserId])
  @@map("im_workspace_members")
}

model IMAsset {
  id                  String   @id @default(cuid()) @db.VarChar(30)
  workspaceId         String   @db.VarChar(30)
  ownerImUserId       String   @db.VarChar(30)
  contentHash         String   @db.Char(64)                       // sha256 hex (64 chars)
  storageUri          String   @db.VarChar(512)
  sizeBytes           BigInt?  @db.BigInt
  mime                String?  @db.VarChar(128)
  kind                String   @default("file") @db.VarChar(32)   // 'file' | 'image' | 'transcript' | 'snippet'
  sourceAgentImUserId String?  @db.VarChar(30)
  sourceTaskId        String?  @db.VarChar(30)
  metadata            String   @default("{}") @db.Text
  createdAt           DateTime @default(now()) @db.DateTime(3)
  updatedAt           DateTime @updatedAt @db.DateTime(3)
  deletedAt           DateTime? @db.DateTime(3)

  parentAssetId  String? @db.VarChar(30)
  derivationKind String? @db.VarChar(32)
  ingestStatus   String  @default("pending") @db.VarChar(32)
  ingestVersion  Int     @default(1)
  ingestError    String? @db.Text
  assetIndexSeq  BigInt  @default(0) @db.BigInt
  cdnUrl         String? @db.VarChar(500)
  previewAssetId String? @db.VarChar(30)
  folderPath     String? @db.VarChar(700)
  filename       String? @db.VarChar(500)
  sourceRef      String? @db.VarChar(500)
  sourceKind     String? @db.VarChar(32)
  sourceMetadata String? @db.Text
  revision       Int     @default(1)
  visibility     String  @default("workspace") @db.VarChar(50)
  aclJson        String? @db.Text
  description    String? @db.VarChar(500)                         // Wave-54 B2: optional agent-authored hint surfaced to other agents

  workspace IMWorkspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentAsset IMAsset?        @relation("IMAssetDerivations", fields: [parentAssetId], references: [id])
  derivedAssets IMAsset[]     @relation("IMAssetDerivations")
  previewAsset IMAsset?       @relation("IMAssetPreview", fields: [previewAssetId], references: [id])
  previewFor   IMAsset[]      @relation("IMAssetPreview")
  files     IMWorkspaceFile[]

  @@unique([workspaceId, contentHash, deletedAt])
  @@index([contentHash])
  @@index([workspaceId, kind])
  @@index([workspaceId, sourceTaskId])
  @@index([workspaceId, deletedAt])
  @@index([workspaceId, assetIndexSeq])
  @@index([workspaceId, sourceRef])
  @@index([workspaceId, ingestStatus])
  @@index([workspaceId, parentAssetId])
  @@index([workspaceId, previewAssetId])
  @@map("im_assets")
}

model IMAssetIndexCounter {
  workspaceId String   @id @db.VarChar(30)
  nextSeq     BigInt   @default(1) @db.BigInt
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  @@map("im_asset_index_counters")
}

// Wave-54 B7: multi-daemon coordination for asset parse work.
// Uniqueness on (workspaceId, assetId, ingestVersion) means one row per
// version; takeover overwrites in place rather than creating a new row.
model IMIngestClaim {
  id               String    @id @default(cuid()) @db.VarChar(30)
  workspaceId      String    @db.VarChar(30)
  assetId          String    @db.VarChar(30)
  ingestVersion    Int
  claimantImUserId String    @db.VarChar(30)
  claimantDeviceId String    @db.VarChar(120)
  status           String    @default("active") @db.VarChar(20)
  claimedAt        DateTime  @db.DateTime(3)
  heartbeatAt      DateTime  @db.DateTime(3)
  completedAt      DateTime? @db.DateTime(3)
  createdAt        DateTime  @default(now()) @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @db.DateTime(3)

  @@unique([workspaceId, assetId, ingestVersion], name: "uq_ingest_claim_target")
  @@index([status, heartbeatAt])
  @@index([claimantImUserId, claimantDeviceId])
  @@map("im_ingest_claims")
}

model IMWorkspaceFile {
  id               String    @id @default(cuid()) @db.VarChar(30)
  workspaceId      String    @db.VarChar(30)
  path             String    @db.VarChar(700)                          // capped to satisfy MySQL InnoDB 3072-byte unique-index limit (see sql/100)
  assetId          String    @db.VarChar(30)
  version          Int       @default(1)
  parentVersionId  String?   @db.VarChar(30)                       // FK 自引用 (历史链)
  modifierImUserId String    @db.VarChar(30)
  createdAt        DateTime  @default(now()) @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @db.DateTime(3)
  deletedAt        DateTime? @db.DateTime(3)

  workspace IMWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  asset     IMAsset     @relation(fields: [assetId], references: [id])

  @@unique([workspaceId, path, deletedAt])
  @@index([workspaceId, updatedAt])
  @@index([assetId])
  @@map("im_workspace_files")
}

model IMAgentProfile {
  id            String    @id @default(cuid()) @db.VarChar(30)
  workspaceId   String    @db.VarChar(30)
  agentImUserId String    @db.VarChar(30)                          // FK → im_users.id (agent role)
  adapterName   String    @db.VarChar(64)                          // 'hermes' | 'claude-code' | 'openclaw' | 'codex'
  name          String    @db.VarChar(128)
  config        String    @default("{}") @db.Text                 // JSON
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @db.DateTime(3)
  deletedAt     DateTime? @db.DateTime(3)

  workspace IMWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, agentImUserId, name, deletedAt])
  @@index([workspaceId, agentImUserId])
  @@map("im_agent_profiles")
}

// ==============================================================================
// v1.9.3 — QR pairing offer (m3 phase 2, see 03-ws-protocol.md §pair)
// ==============================================================================

model IMPairingOffer {
  nonce            String    @id @db.VarChar(64)
  devicePub        String?   @db.VarChar(256)
  deviceName       String?   @db.VarChar(128)
  approverImUserId String?   @db.VarChar(36)
  approvedAt       DateTime? @db.DateTime(3)
  apiKeyId         String?   @db.VarChar(36)
  consumedAt       DateTime? @db.DateTime(3)
  expiresAt        DateTime  @db.DateTime(3)
  createdAt        DateTime  @default(now()) @db.DateTime(3)

  @@index([expiresAt])
  @@map("im_pairing_offers")
}

// ==============================================================================
// Sandbox (Cloud 3 / S2): Container + Snapshot + RunLog
// ==============================================================================

model IMContainer {
  id            String    @id @default(cuid()) @db.VarChar(30)
  workspaceId   String    @db.VarChar(30)
  tenantId      String    @db.VarChar(30)
  agentImUserId String?   @db.VarChar(30)
  taskId        String?   @db.VarChar(30)

  podName       String    @unique @db.VarChar(64)
  namespace     String    @default("default") @db.VarChar(64)
  image         String    @db.VarChar(255)
  imageTag      String    @db.VarChar(64)

  status        String    @db.VarChar(32)

  // Wave-8 W11 — runtime backing kind ("docker" legacy / "k8s" wizard).
  // §26 B5 Stage 1: parallel `deviceType` field added (default mirrors this
  // value via migration 317 backfill). Future stage will retire runtimeKind.
  runtimeKind   String    @default("docker") @db.VarChar(16)

  // §26 B5 Stage 1 — device-semantic fields (migration 317):
  //   deviceType: 'local' | 'k8s' | 'docker-host' | (future) — supersedes
  //     runtimeKind. Defaults 'k8s'; existing rows backfilled from runtimeKind.
  //   daemonId:   1 device = 1 daemon. Nullable in Stage 1 so existing rows
  //     don't fail. Stage 2 code populates on every write; Stage 3 flips NOT NULL.
  deviceType    String    @default("k8s") @db.VarChar(16)
  daemonId      String?   @db.VarChar(64)

  // Migration 322 — provisioning progress signals. provisioningStep is the
  // current step in the 7-step lifecycle (null when not in flight);
  // provisioningHistory is a JSON array of step transitions. camelCase to
  // match the rest of im_containers (runtimeKind, deviceType, ...) — no @map.
  provisioningStep    String? @db.VarChar(32)
  provisioningHistory Json?

  // Migration 323 — §30 §2.6 device capacity model. Maximum agents that
  // can register against this device. Default 3 (Web base subscription
  // tier). Enforcement happens in agent.register (server-side) — schema-only
  // here, read path lands in §30 B3.
  maxAgents     Int       @default(3)

  cpuRequest    String    @db.VarChar(16)
  cpuLimit      String    @db.VarChar(16)
  memoryRequest String    @db.VarChar(16)
  memoryLimit   String    @db.VarChar(16)

  gatewayUrl    String?   @db.VarChar(255)

  startedAt     DateTime? @db.DateTime(3)
  stoppedAt     DateTime? @db.DateTime(3)
  createdAt     DateTime  @default(now()) @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @db.DateTime(3)

  @@index([workspaceId, status])
  @@index([tenantId])
  @@index([taskId])
  @@index([daemonId])
  @@index([deviceType])
  @@index([provisioningStep])
  @@map("im_containers")
}

model IMContainerSnapshot {
  id           String    @id @default(cuid()) @db.VarChar(30)
  containerId  String    @db.VarChar(30)
  // S3 (302): imageTag/imageDigest/sizeBytes are populated by docker-commit
  // snapshots. Daemon-first manifest snapshots leave them null and store
  // the file digest list in `metadata` (kind="fs-manifest").
  imageTag     String?   @db.VarChar(64)
  imageDigest  String?   @db.VarChar(80)
  sizeBytes    BigInt?
  createdBy    String    @db.VarChar(30)
  createdAt    DateTime  @default(now()) @db.DateTime(3)
  // FS manifest may be MB-scale (50k file cap × ~150 bytes JSON ≈ 7.5 MB).
  // TEXT column would 500 on any non-trivial workspace. MediumText = 16 MB.
  metadata     String    @default("{}") @db.MediumText

  @@index([containerId, createdAt])
  @@map("im_container_snapshots")
}

model IMSandboxRunLog {
  id            String    @id @default(cuid()) @db.VarChar(30)
  containerId   String    @db.VarChar(30)
  workspaceId   String    @db.VarChar(30)
  tenantId      String    @db.VarChar(30)

  startedAt     DateTime  @db.DateTime(3)
  endedAt       DateTime? @db.DateTime(3)
  durationMs    Int?
  cpuSeconds    Float?
  memoryGbHours Float?

  trigger       String    @db.VarChar(32)
  taskId        String?   @db.VarChar(30)

  exitReason    String?   @db.VarChar(32)
  exitCode      Int?

  createdAt     DateTime  @default(now()) @db.DateTime(3)

  @@index([tenantId, startedAt])
  @@index([workspaceId, startedAt])
  @@map("im_sandbox_run_logs")
}
