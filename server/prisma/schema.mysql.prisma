model IMSkill {
  id                      String    @id @default(cuid()) @db.VarChar(30)
  slug                    String    @unique @db.VarChar(200)
  name                    String    @db.VarChar(256)
  description             String    @default("") @db.Text
  category                String    @default("general") @db.VarChar(50)
  tags                    String    @default("[]") @db.Text // JSON: string[]
  author                  String    @default("") @db.VarChar(128)
  source                  String    @default("community") @db.VarChar(30)
  sourceUrl               String    @default("") @db.VarChar(512)
  sourceId                String    @default("") @db.VarChar(256)
  content                 String    @default("") @db.MediumText
  // v2.1 §A.7 — multi-file manifest (agentskills.io compliance)
  contentManifest         String?   @db.MediumText // JSON [{path,sha256,size,content?(b64),url?,inline}]
  contentManifestRevision String?   @db.VarChar(64)
  installs                Int       @default(0)
  stars                   Int       @default(0)
  qualityScore            Float     @default(0.01) @db.Double
  // status enum (app-layer): 'active' | 'deprecated' | 'pending_review' | 'draft'
  //   • 'draft'     — release201/07 skill-authoring output; NOT in marketplace search,
  //                   NOT installable, NOT synced to daemons (see services/skill-draft.service.ts).
  //   • 'active'    — published / catalog / built-in.
  //   • 'pending_review' — community submission awaiting moderation.
  //   • 'deprecated' — soft-deleted.
  status                  String    @default("active") @db.VarChar(20)
  geneId                  String?   @db.VarChar(128)
  metadata                String    @default("{}") @db.Text
  executableJson          Json?
  createdAt               DateTime  @default(now()) @db.DateTime(3)
  updatedAt               DateTime  @updatedAt @db.DateTime(3)
  publishedAt             DateTime? @db.DateTime(3) // v2.1 §A.7 marketplace publish timestamp

  // v1.7.2: Skill Ecosystem enhancements
  packageUrl     String? @db.VarChar(512)
  packageHash    String? @db.VarChar(64)
  packageSize    Int?
  fileCount      Int     @default(1)
  compatibility  String  @default("[]") @db.Text // JSON: platform[]
  signals        String  @default("[]") @db.Text // JSON: SignalTag[]
  requires       String  @default("{}") @db.Text // JSON: { env, bins, capabilities }
  version        String  @default("1.0.0") @db.VarChar(20)
  ownerAgentId   String? @db.VarChar(30)
  forkedFrom     String? @db.VarChar(30)
  forkCount      Int     @default(0)
  license        String  @default("MIT") @db.VarChar(30)
  securityStatus String  @default("pending") @db.VarChar(20)
  changelog      String  @default("") @db.Text

  workspaceId String? @db.VarChar(30) // 1.9.2 Phase 1 (m2 NULLable, m3 NOT NULL + drop scope)

  // release201/08 §5.1 — Lifecycle SOP fields (migration 430)
  // lifecycleStage: draft | eval | review | published | archived
  // publishScope:   private | workspace | org | community
  // Invariants enforced by SkillLifecycleService:
  //   • lifecycleStage IN (draft,eval,review)  ↔ status='draft'
  //   • lifecycleStage='published'             ↔ status='active' AND publishedAt IS NOT NULL
  //   • lifecycleStage='archived'              ↔ status='deprecated'
  lifecycleStage String @default("published") @db.VarChar(20) @map("lifecycle_stage")
  publishScope   String @default("private")   @db.VarChar(16) @map("publish_scope")

  // release202/09 §3.3 — capability-stack governance (migration 456)
  //   • isSystem        — true = system-capability built-in (A-list); soft predicate
  //                       `source='prismer' AND category='built-in'` is now made explicit.
  //   • defaultEnabled  — true = auto-installed onto NEW agents by default. General
  //                       (B-list) built-ins seed `false` so the owner re-enables them
  //                       one-by-one via /admin/skills (per-agent disable substrate).
  isSystem       Boolean @default(false) @map("is_system")
  defaultEnabled Boolean @default(false) @map("default_enabled")

  @@index([category])
  @@index([source])
  @@index([installs])
  @@index([status])
  @@index([sourceId])
  @@index([ownerAgentId])
  @@index([workspaceId])
  @@index([contentManifestRevision])
  @@index([lifecycleStage], map: "idx_lifecycle_stage")
  @@index([publishScope], map: "idx_publish_scope")
  @@map("im_skills")
}

// release201/08 §3.4 + §5.2 — Eval session run history (migration 431).
//
// Each row is one eval invocation against a draft skill. Service flow:
//   1. SkillLifecycleService.startEvalRun() inserts a row with status='queued'
//      and pushes a daemon dispatch envelope.
//   2. Daemon EvalSessionRunner marks status='running' (started_at set),
//      runs each test case in an isolated tempHome, then POSTs back to
//      /api/im/skills/:id/eval/runs/:runId/finish with per-case results.
//   3. recordEvalFinish() writes results_json + pass/fail counters and, when
//      pass rate ≥ 0.8, auto-promotes the skill from eval → review.
model IMSkillEvalRun {
  id            String    @id @db.VarChar(30)
  skillId       String    @db.VarChar(30) @map("skill_id")
  status        String    @db.VarChar(20) // queued|running|finished|aborted|error
  daemonId      String?   @db.VarChar(30) @map("daemon_id")
  passCount     Int       @default(0) @map("pass_count")
  failCount     Int       @default(0) @map("fail_count")
  testCasesJson String    @db.Text @map("test_cases_json")
  resultsJson   String?   @db.Text @map("results_json")
  agentTraceUrl String?   @db.VarChar(500) @map("agent_trace_url")
  startedAt     DateTime? @db.DateTime(3) @map("started_at")
  finishedAt    DateTime? @db.DateTime(3) @map("finished_at")
  createdAt     DateTime  @default(now()) @db.DateTime(3) @map("created_at")

  @@index([skillId], map: "idx_skill")
  @@index([status], map: "idx_status")
  @@index([createdAt], map: "idx_created")
  @@map("im_skill_eval_runs")
}

