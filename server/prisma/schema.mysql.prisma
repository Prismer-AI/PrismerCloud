// ==============================================================================
// Sandbox (Cloud 3 / S2): Container + Snapshot + RunLog
// ==============================================================================

model IMContainer {
  id            String  @id @default(cuid()) @db.VarChar(30)
  workspaceId   String  @db.VarChar(30)
  // Migration 448 (release201/20 §1) — optional project scope for
  // runtime-installation containers. NULL = workspace-level. Validated at
  // service layer (must belong to same workspace; same style as 09 §3.3
  // task projectId — no FK to keep cascade flexible).
  projectId     String? @db.VarChar(30)
  tenantId      String  @db.VarChar(30)
  agentImUserId String? @db.VarChar(30)
  taskId        String? @db.VarChar(30)

  podName   String @unique @db.VarChar(64)
  namespace String @default("default") @db.VarChar(64)
  image     String @db.VarChar(255)
  imageTag  String @db.VarChar(64)

  status String @db.VarChar(32)

  // Wave-8 W11 — runtime backing kind ("docker" legacy / "k8s" wizard).
  // §26 B5 Stage 1: parallel `deviceType` field added (default mirrors this
  // value via migration 317 backfill). Future stage will retire runtimeKind.
  runtimeKind String @default("docker") @db.VarChar(16)

  // §26 B5 Stage 1 — device-semantic fields (migration 317):
  //   deviceType: 'local' | 'k8s' | 'docker-host' | (future) — supersedes
  //     runtimeKind. Defaults 'k8s'; existing rows backfilled from runtimeKind.
  //   daemonId:   1 device = 1 daemon. Nullable in Stage 1 so existing rows
  //     don't fail. Stage 2 code populates on every write; Stage 3 flips NOT NULL.
  deviceType String  @default("k8s") @db.VarChar(16)
  daemonId   String? @db.VarChar(64)

  // Migration 336 (08 §6.1) — Provider abstraction convergence field.
  // Replaces the runtimeKind+deviceType pair. Kept in parallel during the
  // dual-write window; v210 drops the legacy pair.
  providerKind       String    @default("k8s") @db.VarChar(64)
  // Migration 336 (08 §5.4) — Daemon health probe state for the reconciler
  // loop. misses≥3 → status=degraded; reset to 0 on a successful probe.
  daemonHealthMisses Int       @default(0)
  lastDaemonHealthAt DateTime? @db.DateTime(3)

  // Migration 322 — provisioning progress signals. provisioningStep is the
  // current step in the 7-step lifecycle (null when not in flight);
  // provisioningHistory is a JSON array of step transitions. camelCase to
  // match the rest of im_containers (runtimeKind, deviceType, ...) — no @map.
  provisioningStep    String? @db.VarChar(32)
  provisioningHistory Json?

  // Migration 323 — §30 §2.6 device capacity model. Maximum agents that
  // can register against this device. Default 3 (Web base subscription
  // tier). Enforcement happens in agent.register (server-side) — schema-only
  // here, read path lands in §30 B3.
  // 2026-06-06 — schema default was still 3 while DB migration 340 bumped the
  // column DEFAULT to 10; Prisma bakes the SCHEMA default into the insert, so
  // every Prisma-created device got 3 → the "maximum is 3" cap. Align to 10.
  maxAgents Int @default(10)

  cpuRequest    String @db.VarChar(16)
  cpuLimit      String @db.VarChar(16)
  memoryRequest String @db.VarChar(16)
  memoryLimit   String @db.VarChar(16)

  gatewayUrl String? @db.VarChar(255)

  // v2.0 §4.8 (migration 409): daemon transport-probe report. Used by
  // /runtime/diagnose + dispatch path to pick WS reverse-channel vs HTTP
  // gateway. transport ∈ 'ws' | 'http' | 'both'. gatewayIsPrivate=true
  // when gatewayUrl resolves to RFC1918 — HTTP fallback is then skipped
  // for cross-network dispatch.
  transport        String?   @db.VarChar(10)
  gatewayIsPrivate Boolean?
  lastProbeAt      DateTime? @db.DateTime(3)

  startedAt DateTime? @db.DateTime(3)
  stoppedAt DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)

  @@index([workspaceId, status])
  @@index([tenantId])
  @@index([taskId])
  @@index([daemonId])
  @@index([deviceType])
  @@index([provisioningStep])
  @@index([providerKind, status])
  @@index([transport, lastProbeAt], map: "im_containers_transport_idx")
  // Migration 448 — project scope filter (release201/20 §1).
  @@index([projectId, status], map: "idx_project")
  @@map("im_containers")
}

model IMContainerSnapshot {
  id             String            @id @default(cuid()) @db.VarChar(30)
  containerId    String            @db.VarChar(30)
  // S3 (302): imageTag/imageDigest/sizeBytes are populated by docker-commit
  // snapshots. Daemon-first manifest snapshots leave them null and store
  // the file digest list in `metadata` (kind="fs-manifest").
  imageTag       String?           @db.VarChar(64)
  imageDigest    String?           @db.VarChar(80)
  sizeBytes      BigInt?
  createdBy      String            @db.VarChar(30)
  createdAt      DateTime          @default(now()) @db.DateTime(3)
  // FS manifest may be MB-scale (50k file cap × ~150 bytes JSON ≈ 7.5 MB).
  // TEXT column would 500 on any non-trivial workspace. MediumText = 16 MB.
  metadata       String            @default("{}") @db.MediumText
  agentSnapshots IMAgentSnapshot[]

  @@index([containerId, createdAt])
  @@map("im_container_snapshots")
}

model IMAgentSnapshot {
  id                      String   @id @default(cuid()) @db.VarChar(30)
  agentImUserId           String   @db.VarChar(30)
  workspaceId             String   @db.VarChar(30)
  definitionJson          Json
  skillsJson              Json
  containerSnapshotId     String?  @db.VarChar(30)
  perAgentDirManifestJson Json?
  memoryDumpRef           String?  @db.VarChar(255)
  includeMemory           Boolean  @default(false)
  createdAt               DateTime @default(now()) @db.DateTime(3)
  createdBy               String   @db.VarChar(30)
  status                  String   @default("ready") @db.VarChar(20)
  sizeBytes               BigInt?

  containerSnapshot IMContainerSnapshot? @relation(fields: [containerSnapshotId], references: [id], onDelete: SetNull)

  @@index([agentImUserId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([containerSnapshotId])
  @@map("im_agent_snapshots")
}

model IMAgentPackage {
