# Dependencies
node_modules/
.venv/
vendor/
__pycache__/
*.pyc
package-lock.json
!.test/package-lock.json
# server/ ships a lockfile so CI installs reproducible versions that match
# the v1.8.2 baseline (Next.js + Hono + Stripe types are version-sensitive).
!server/package-lock.json

# Build artifacts
dist/
*.tgz
server/public/pdf.worker.min.mjs
server/public/pdfjs/
*.egg-info/
build/artifacts/
build/sync-server/state/
build/sync-server/patches/
target/
sdk/golang/prismer
.next/

# Auth tokens (release credentials — NEVER commit)
.npmrc
.pypirc
.cargo-credentials

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Local agent runtime / settings (not project state)
.gstack/
.claude/
