{
  "name": "@prismer/runtime",
  "version": "2.0.8",
  "description": "Prismer Cloud daemon runtime — TS-only adapter host for hosted IM agents",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "assets",
    "built-in-skills",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "prismer": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "node scripts/prebuild-copy-built-in-skills.cjs",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist built-in-skills"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.8.0",
    "commander": "^12.1.0",
    "qrcode": "^1.5.4",
    "undici": "^7.24.0",
    "ws": "^8.19.0",
    "yaml": "^2.8.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.19.37",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Prismer-AI/PrismerCloud.git",
    "directory": "sdk/prismer-cloud/runtime"
  },
  "license": "MIT",
  "keywords": [
    "prismer",
    "daemon",
    "agent",
    "runtime",
    "adapter"
  ]
}
