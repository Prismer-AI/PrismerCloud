{
  "name": "@prismer/runtime",
  "version": "2.2.64",
  "description": "Prismer Cloud daemon runtime — TS-only adapter host for hosted IM agents",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "assets",
    "built-in-skills",
    "apc",
    "components",
    "plugins",
    "!plugins/**/__pycache__",
    "!plugins/**/*.pyc",
    "!plugins/**/test_*.py",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "prismer": "./dist/cli.js",
    "prismer-runtime": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "node ../cloud/scripts/gen-eaas-components.cjs --check && node ../build/stage-pkf-core.cjs . --skip-build && node scripts/prebuild-copy-built-in-skills.cjs",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist built-in-skills"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.17.1",
    "@anthropic-ai/claude-agent-sdk": "^0.2.141",
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opencode-ai/sdk": "^1.14.46",
    "ajv": "^8.20.0",
    "better-sqlite3": "^11.8.0",
    "commander": "^12.1.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.5",
    "ioredis": "^5.11.1",
    "katex": "^0.16.27",
    "mysql2": "^3.23.1",
    "p-limit": "^6.2.0",
    "pi-mcp-adapter": "2.36.0",
    "pi-web-access": "0.30.0",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "strip-ansi": "^7.2.0",
    "tree-kill": "^1.2.2",
    "typebox": "1.3.7",
    "undici": "^7.24.0",
    "unified": "^11.0.5",
    "which": "^5.0.0",
    "ws": "^8.19.0",
    "yaml": "^2.8.2",
    "zod": "^4.0.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.19.37",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "node-pty": "^1.1.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Prismer-AI/PrismerCloud.git",
    "directory": "sdk/prismer"
  },
  "license": "MIT",
  "keywords": [
    "prismer",
    "daemon",
    "agent",
    "runtime",
    "adapter"
  ]
}
